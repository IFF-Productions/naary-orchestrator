#cloud-config
# First-boot provisioning for the naary Hetzner server (rendered by hetzner.tf).
# Installs Docker (with the compose v2 plugin — >= 2.24, needed for the overlays'
# !override/!reset) and stages the generated .env. That's ALL a box needs: the app
# arrives as prebuilt GHCR images via the Deploy workflow, which ships the compose
# files over SSH and `docker compose pull && up`s. No repo, no source, no git on the box.

package_update: true
packages:
  - ca-certificates
  - curl

write_files:
  - path: /opt/naary/.env
    permissions: "0600"
    content: |
      ${indent(6, env_file)}

# 4 GiB swap — absorbs the worker's boot-time RSS spike (in-process webpack bundle of the
# workflow code + quickjs-emscripten WASM) so the kernel doesn't OOM-kill a NEW worker during
# docker-rollout's 2x-scale rolling replace on this 8GB box. cloud-init writes /swapfile,
# enables it, AND adds the fstab entry (survives reboot). Bytes as integers per the cc_mounts
# schema. NB cloud-init runs on FIRST BOOT only — the Deploy workflow ensures swap on the
# EXISTING box (idempotent step) so this covers freshly-provisioned boxes.
swap:
  filename: /swapfile
  size: 4294967296
  maxsize: 4294967296

runcmd:
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  - echo "naary — Docker ready, .env staged at /opt/naary/.env. Deploy from GitHub Actions (Actions -> Release, or Deploy with a tag); it ships the compose files and pulls the GHCR images." > /etc/motd
