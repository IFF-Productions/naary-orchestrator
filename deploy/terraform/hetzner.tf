# Hetzner Cloud server for the prod stack. Pairs with the Cloudflare Tunnel in main.tf:
# the server needs NO inbound web ports (cloudflared dials out), so the firewall admits
# SSH only. Delete this file (and the hcloud provider) to go back to bring-your-own-box.

provider "hcloud" {
  token = var.hcloud_token
}

# ── Secrets baked into the server .env ────────────────────────────────────────────────
# These land in Terraform state (like the tunnel secret already does) — keep the state
# bucket private. ENCRYPTION_KEY especially: losing it invalidates every stored tenant
# credential, so with state as the source of truth, protect/version the bucket.

# The REAL Postgres superuser password on the data box (data-plane.tf) — the app box's
# DATABASE_URL embeds it, so it must stay URL-safe (alphanumeric, no encoding needed).
# Historically a placeholder for Neon-era compose interpolation; same value, now live.
resource "random_password" "postgres" {
  length  = 32
  special = false
}

# 32-byte hex, as the app requires. Stable across applies (random_id never rotates
# unless tainted or its keepers change — it has none).
resource "random_id" "encryption_key" {
  byte_length = 32
}

locals {
  # Object storage lines for the generated .env — present only when s3.tf created a bucket.
  #
  # Emitted here rather than left for the operator to paste, because a missing bucket is not a soft
  # degradation: hosted-form logo uploads fail closed with a 503 (deliberately — a logo held in one API
  # process's memory would vanish on the next rolling deploy and differ per replica). Credentials are
  # the dedicated least-privilege IAM key from s3.tf, never the operator's own.
  #
  # Built with join() and `one()`, NOT a heredoc in a ternary: HCL rejects the latter outright, and
  # `one(...[*].id)` yields null (→ "") when count is 0, so no [0] index is evaluated when create_s3 is
  # false. Concatenated onto server_env_base below rather than interpolated INSIDE its `<<-EOT`, because
  # a multi-line value dropped into an indented heredoc breaks the `<<-` dedent for the whole block.
  server_env_s3 = var.create_s3 ? join("\n", [
    "STORAGE_PROVIDER=s3",
    "S3_BUCKET=${var.s3_bucket_name}",
    "AWS_REGION=${var.aws_region}",
    "AWS_ACCESS_KEY_ID=${one(aws_iam_access_key.naary[*].id)}",
    "AWS_SECRET_ACCESS_KEY=${one(aws_iam_access_key.naary[*].secret)}",
    "", # trailing newline, so the generated .env ends cleanly
  ]) : ""

  # The final file cloud-init writes to /opt/naary/.env.
  server_env = "${local.server_env_base}${local.server_env_s3}"

  # Written to /opt/naary/.env by cloud-init. Mirrors deploy/.env.prod.example —
  # optional extras (Firebase, Sentry, …) can be appended on the server later.
  #
  # DB + Temporal live on the SELF-HOSTED data box (data-plane.tf), reached over the
  # private network. Both URLs are the same direct connection (no pooler in between —
  # Prisma's own pool talks straight to Postgres). No TEMPORAL_API_KEY/TLS: the
  # self-hosted cluster is reachable ONLY on the private network, plaintext gRPC.
  server_env_base = <<-EOT
    # Generated by Terraform (deploy/terraform/hetzner.tf). SECRETS — never commit.
    # DB + Temporal are on the naary-data box (private network) — see data-plane.tf.
    POSTGRES_USER=naary
    POSTGRES_PASSWORD=${random_password.postgres.result}
    POSTGRES_DB=naary_orchestrator
    DATABASE_URL=postgresql://naary:${random_password.postgres.result}@${local.data_private_ip}:5432/naary_orchestrator?schema=public&connect_timeout=15
    MIGRATE_DATABASE_URL=postgresql://naary:${random_password.postgres.result}@${local.data_private_ip}:5432/naary_orchestrator?schema=public&connect_timeout=15
    ENCRYPTION_KEY=${random_id.encryption_key.hex}
    CLOUDFLARE_TUNNEL_TOKEN=${cloudflare_zero_trust_tunnel_cloudflared.naary.tunnel_token}
    PUBLIC_HOSTNAME=${var.hostname}
    TEMPORAL_ADDRESS=${local.data_private_ip}:7233
    TEMPORAL_NAMESPACE=default
  EOT
}

resource "hcloud_ssh_key" "naary" {
  name       = "${var.server_name}-admin"
  public_key = var.ssh_public_key
}

# Dedicated key for the GitHub Actions deploy workflow (.github/workflows/deploy.yml) —
# its PRIVATE half goes in the repo's DEPLOY_SSH_KEY secret, never your personal key.
resource "hcloud_ssh_key" "deploy" {
  count      = var.deploy_ssh_public_key != "" ? 1 : 0
  name       = "${var.server_name}-deploy"
  public_key = var.deploy_ssh_public_key
}

# Inbound: SSH (+ ping) only. 80/443 stay CLOSED — traffic arrives via the tunnel.
# No outbound rules defined ⇒ Hetzner allows all outbound (cloudflared, apt, registries).
resource "hcloud_firewall" "naary" {
  name = "${var.server_name}-ssh-only"

  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "22"
    source_ips = var.ssh_allowed_cidrs
  }

  rule {
    direction  = "in"
    protocol   = "icmp"
    source_ips = ["0.0.0.0/0", "::/0"]
  }
}

resource "hcloud_server" "naary" {
  name        = var.server_name
  server_type = var.server_type
  location    = var.server_location
  image       = "ubuntu-24.04"
  # NOTE: ssh_keys are injected at CREATE time — adding one later replaces the server.
  # Set deploy_ssh_public_key before the first apply (or append to authorized_keys by hand).
  ssh_keys     = concat([hcloud_ssh_key.naary.id], hcloud_ssh_key.deploy[*].id)
  firewall_ids = [hcloud_firewall.naary.id]

  user_data = templatefile("${path.module}/cloud-init.yaml.tftpl", {
    env_file = local.server_env
  })

  labels = {
    app        = "naary"
    managed_by = "terraform"
  }

  # cloud-init runs on FIRST BOOT only, but user_data is a create-time attribute — a
  # changed template would otherwise force the server to be REPLACED. Ignore it so
  # template evolution never destroys a live box (new boxes always get the latest;
  # to force-apply a template change to an existing one: terraform taint, or update
  # the box by hand — it only stages Docker + /opt/naary/.env anyway).
  lifecycle {
    create_before_destroy = false
    ignore_changes        = [user_data]
  }
}
