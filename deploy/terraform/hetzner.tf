# Hetzner Cloud server for the prod stack. Pairs with the Cloudflare Tunnel in main.tf:
# the server needs NO inbound web ports (cloudflared dials out), so the firewall admits
# SSH only. Delete this file (and the hcloud provider) to go back to bring-your-own-box.

provider "hcloud" {
  token = var.hcloud_token
}

# ── Secrets baked into the server .env ────────────────────────────────────────────────
# These land in Terraform state (like the tunnel secret already does) — keep the state
# bucket private. ENCRYPTION_KEY especially: losing it invalidates every stored tenant
# credential, so with state as the source of truth, protect/version the bucket.

# The DB is Neon (neon.tf), but the base compose still interpolates
# ${POSTGRES_PASSWORD:?} at parse time even with the postgres service profiled off,
# so a value must exist. URL-safe (alphanumeric) in case it's ever used for real.
resource "random_password" "postgres" {
  length  = 32
  special = false
}

# 32-byte hex, as the app requires. Stable across applies (random_id never rotates
# unless tainted or its keepers change — it has none).
resource "random_id" "encryption_key" {
  byte_length = 32
}

locals {
  # Written to /opt/naary/.env by cloud-init. Mirrors deploy/.env.prod.example —
  # optional extras (Firebase, Sentry, S3, …) can be appended on the server later.
  server_env = <<-EOT
    # Generated by Terraform (deploy/terraform/hetzner.tf). SECRETS — never commit.
    # DB is Neon; POSTGRES_* only satisfy base-compose interpolation (service is off).
    POSTGRES_USER=naary
    POSTGRES_PASSWORD=${random_password.postgres.result}
    POSTGRES_DB=naary_orchestrator
    DATABASE_URL=${local.neon_database_url_pooled}
    MIGRATE_DATABASE_URL=${local.neon_database_url_direct}
    ENCRYPTION_KEY=${random_id.encryption_key.hex}
    CLOUDFLARE_TUNNEL_TOKEN=${cloudflare_zero_trust_tunnel_cloudflared.naary.tunnel_token}
    PUBLIC_HOSTNAME=${var.hostname}
    TEMPORAL_ADDRESS=${var.temporal_address}
    TEMPORAL_NAMESPACE=${var.temporal_namespace}
    TEMPORAL_API_KEY=${var.temporal_api_key}
  EOT

  # Only auto-start the stack when cloud-init has everything it needs; otherwise the
  # worker/api would crash-loop against an empty TEMPORAL_ADDRESS.
  auto_up = var.repo_url != "" && var.temporal_address != ""
}

resource "hcloud_ssh_key" "naary" {
  name       = "${var.server_name}-admin"
  public_key = var.ssh_public_key
}

# Dedicated key for the GitHub Actions deploy workflow (.github/workflows/deploy.yml) —
# its PRIVATE half goes in the repo's DEPLOY_SSH_KEY secret, never your personal key.
resource "hcloud_ssh_key" "deploy" {
  count      = var.deploy_ssh_public_key != "" ? 1 : 0
  name       = "${var.server_name}-deploy"
  public_key = var.deploy_ssh_public_key
}

# Inbound: SSH (+ ping) only. 80/443 stay CLOSED — traffic arrives via the tunnel.
# No outbound rules defined ⇒ Hetzner allows all outbound (cloudflared, apt, registries).
resource "hcloud_firewall" "naary" {
  name = "${var.server_name}-ssh-only"

  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "22"
    source_ips = var.ssh_allowed_cidrs
  }

  rule {
    direction  = "in"
    protocol   = "icmp"
    source_ips = ["0.0.0.0/0", "::/0"]
  }
}

resource "hcloud_server" "naary" {
  name        = var.server_name
  server_type = var.server_type
  location    = var.server_location
  image       = "ubuntu-24.04"
  # NOTE: ssh_keys are injected at CREATE time — adding one later replaces the server.
  # Set deploy_ssh_public_key before the first apply (or append to authorized_keys by hand).
  ssh_keys     = concat([hcloud_ssh_key.naary.id], hcloud_ssh_key.deploy[*].id)
  firewall_ids = [hcloud_firewall.naary.id]

  user_data = templatefile("${path.module}/cloud-init.yaml.tftpl", {
    env_file = local.server_env
    repo_url = var.repo_url
    auto_up  = local.auto_up
  })

  labels = {
    app        = "naary"
    managed_by = "terraform"
  }

  # cloud-init only runs on first boot; a changed template must recreate the server.
  # The DB is on Neon and execution state in Temporal Cloud, so the box holds no
  # irreplaceable data — but replacement still means a few minutes of downtime.
  lifecycle {
    create_before_destroy = false
  }
}
