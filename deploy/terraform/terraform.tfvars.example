# Copy to terraform.tfvars (gitignored) and fill in. Or export as TF_VAR_* env vars.
# The API token is a SECRET — never commit terraform.tfvars.

cloudflare_api_token  = "your-cloudflare-api-token"   # Account: Cloudflare Tunnel:Edit + Zone: DNS:Edit
cloudflare_account_id = "your-account-id"
cloudflare_zone_id    = "the-zone-id-for-naar-y.com"

hostname = "naar-y.com"    # or "app.naar-y.com"

# ── Hetzner server ─────────────────────────────────────────────────────────────────────
hcloud_token   = "your-hetzner-api-token"             # project → Security → API tokens (Read & Write)
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"     # contents of ~/.ssh/id_ed25519.pub
# server_type     = "cx33"                            # 4 vCPU / 8 GB, EU-only (see variables.tf)
# server_location = "nbg1"
# ssh_allowed_cidrs = ["203.0.113.7/32"]              # tighten SSH to your IP if static

# ── Neon (managed Postgres) ────────────────────────────────────────────────────────────
neon_api_key = "your-neon-api-key"                    # console → Account settings → API keys
# neon_region = "aws-eu-central-1"

# ── Temporal Cloud (recommended: set now so the generated .env is complete) ────────────
# Empty ⇒ cloud-init still stages /opt/naary/.env; fill these in on the server before
# the first deploy. The app itself arrives via GitHub Actions (GHCR images) — no repo
# access or PAT is needed on the box.
# temporal_address   = "eu-central-1.aws.api.temporal.io:7233"
# temporal_namespace = "naary.abc12"
# temporal_api_key   = "tmprl_..."
