# ── Self-hosted data plane (#relocation from Neon + Temporal Cloud) ────────────────────
# A second Hetzner server ("naary-data") runs Postgres (pgvector) + a self-hosted
# Temporal cluster (auto-setup, Postgres-backed) + the Temporal UI. The app box reaches
# both over a PRIVATE Hetzner network — neither 5432 nor 7233 is ever on a public
# interface (the compose file binds them to the private IP + loopback only, and the
# SSH-only firewall covers the public side regardless).
#
# Why a private network and not the public IP + firewall: Hetzner cloud firewalls do
# not apply to private-network traffic, and private traffic stays inside the project's
# isolated network zone — so the app box dials 10.0.1.3 and nothing else can.
#
# The stack itself (deploy/data/docker-compose.yml) is shipped + started by
# deploy/data/deploy.sh — cloud-init here only stages Docker and the generated .env,
# exactly like the app box.

# One /16, with a /24 subnet that spans the eu-central network zone (nbg1/fsn1/hel1 —
# so the data box keeps its address even if it ever has to live in another EU location).
resource "hcloud_network" "naary" {
  name     = "naary"
  ip_range = "10.0.0.0/16"
}

resource "hcloud_network_subnet" "naary" {
  network_id   = hcloud_network.naary.id
  type         = "cloud"
  network_zone = "eu-central"
  ip_range     = "10.0.1.0/24"
}

locals {
  app_private_ip  = "10.0.1.2"
  data_private_ip = "10.0.1.3"
}

# Attach the EXISTING app box. Attaching is additive (a hot-plugged NIC) — it does not
# replace the server. NOTE for a LIVE box the stock image does NOT auto-configure the
# hot-plugged NIC: drop a plain-DHCP netplan for enp7s0 (see the templates' 60-private-net
# file) and `netplan apply`. DHCP supplies the address + the 10.0.0.0/16 route via the
# NETWORK gateway 10.0.0.1.
resource "hcloud_server_network" "app" {
  server_id = hcloud_server.naary.id
  subnet_id = hcloud_network_subnet.naary.id
  ip        = local.app_private_ip
}

resource "hcloud_server_network" "data" {
  server_id = hcloud_server.naary_data.id
  subnet_id = hcloud_network_subnet.naary.id
  ip        = local.data_private_ip
}

# The .env cloud-init writes to /opt/naary-data/.env on the data box. BIND_IP is the
# address the compose file publishes Postgres/Temporal on (the private IP — never
# 0.0.0.0). The Postgres superuser password is the SAME random_password.postgres the
# app box's DATABASE_URL is built from (alphanumeric → URL-safe, see hetzner.tf).
locals {
  data_server_env = <<-EOT
    # Generated by Terraform (deploy/terraform/data-plane.tf). SECRETS — never commit.
    POSTGRES_USER=naary
    POSTGRES_PASSWORD=${random_password.postgres.result}
    POSTGRES_DB=naary_orchestrator
    BIND_IP=${local.data_private_ip}
  EOT
}

resource "hcloud_server" "naary_data" {
  name        = var.data_server_name
  server_type = var.data_server_type
  location    = var.data_server_location
  image       = "ubuntu-24.04"
  # Same admin + deploy keys as the app box (injected at CREATE time only).
  ssh_keys     = concat([hcloud_ssh_key.naary.id], hcloud_ssh_key.deploy[*].id)
  firewall_ids = [hcloud_firewall.naary.id] # SSH-only; private-net traffic is unfiltered by design

  user_data = templatefile("${path.module}/cloud-init-data.yaml.tftpl", {
    env_file = local.data_server_env
  })

  labels = {
    app        = "naary"
    role       = "data"
    managed_by = "terraform"
  }

  # Same rationale as the app box: user_data is create-time; never let template
  # evolution force-replace a live database server.
  lifecycle {
    create_before_destroy = false
    ignore_changes        = [user_data]
  }
}
