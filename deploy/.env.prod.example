# Server .env for the self-hosted + Cloudflare Tunnel deploy.
# Copy to `.env` at the REPO ROOT on the server (docker compose auto-loads it).
# Everything here is a SECRET — chmod 600 .env, never commit it.
#
# ── Variant B (Hetzner + Neon, deploy/README.md) — you don't write this file ──────────
#   Terraform GENERATES the server .env (deploy/terraform/hetzner.tf → cloud-init),
#   including DATABASE_URL / MIGRATE_DATABASE_URL for Neon. What you configure by hand
#   is the CI/CD side — GitHub → repo Settings → Secrets and variables → Actions:
#
#     DEPLOY_SSH_KEY   private half of the dedicated deploy keypair
#                      (ssh-keygen -t ed25519 -f deploy_key -N "" — the PUBLIC half
#                       goes in terraform.tfvars as deploy_ssh_public_key BEFORE the
#                       first apply; never reuse your personal key)
#     DEPLOY_HOST      the server's IPv4: terraform -chdir=deploy/terraform output -raw server_ipv4
#
#   These are SECRETS for .github/workflows/deploy.yml (release-driven deploys +
#   rollbacks). release.yml needs no extra secrets — it uses the built-in GITHUB_TOKEN,
#   and the box pulls its GHCR images with the deploy run's ephemeral token.
#
#   VITE_* values below are IGNORED in Variant B — the web image is prebuilt in CI, so
#   set them as repo VARIABLES (same settings page, Variables tab) instead; deploy.yml
#   passes them as build args.

# ── Postgres (self-hosted in the stack; DATABASE_URL is derived from these) ──────────
POSTGRES_USER=naary
# Use a URL-SAFE password (hex) — it's interpolated into DATABASE_URL, so chars like
# / + @ : # ? would corrupt the connection string. `openssl rand -hex 24` is always safe.
POSTGRES_PASSWORD=          # openssl rand -hex 24
POSTGRES_DB=naary_orchestrator

# ── App crypto — REQUIRED. 32-byte hex. Losing/rotating this invalidates stored
#    tenant credentials, so back it up somewhere safe (a password manager). ───────────
ENCRYPTION_KEY=             # openssl rand -hex 32

# ── External secret store for BYOK provider keys (#458). OPTIONAL. Unset = Postgres
#    (default). `vault` moves the key MATERIAL into Vault KV v2; Postgres keeps only the
#    index row. api + worker must agree. ENCRYPTION_KEY is still required (legacy rows +
#    all other secrets). Fails closed on incomplete config.
#    NOT YET EXERCISED AGAINST A LIVE VAULT — see docs/design/EXTERNAL-SECRET-STORE.md.
# SECRET_PROVIDER=vault
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=
# VAULT_KV_MOUNT=secret
# VAULT_PATH_PREFIX=naary
# VAULT_NAMESPACE=

# ── Cloudflare Tunnel — from: terraform -chdir=deploy/terraform output -raw tunnel_token
CLOUDFLARE_TUNNEL_TOKEN=

# Used only for the api's CORS origin (see docker-compose.prod.yml).
PUBLIC_HOSTNAME=naar-y.com

# ── Temporal Cloud — REQUIRED in prod. The prod stack does NOT run a local Temporal
#    (docker-compose.prod.yml profile-gates it off); durable execution is Temporal Cloud.
#    Setup: in the Temporal Cloud UI create a Namespace, then an API Key (Settings → API
#    Keys). The namespace page shows the regional gRPC endpoint. With an API key, TLS is
#    auto-enabled and the namespace is routed for you (@naary/temporal-config).
TEMPORAL_ADDRESS=<region>.<cloud>.api.temporal.io:7233   # e.g. us-east-1.aws.api.temporal.io:7233
TEMPORAL_NAMESPACE=<namespace>.<account>                 # the fully-qualified namespace id
TEMPORAL_API_KEY=<temporal-cloud-api-key>
#    mTLS alternative (instead of the API key): mount the client cert pair + set
# TEMPORAL_TLS_CERT_PATH=/run/secrets/temporal.pem
# TEMPORAL_TLS_KEY_PATH=/run/secrets/temporal.key
#    Local dev (plain `docker compose up`, no prod overlay) ignores all of the above and
#    uses the in-stack start-dev server at temporal:7233.

# ── Firebase (human browser login). OPTIONAL — leave unset for API-token-only mode
#    (mint an nry_ token in the UI/CLI and paste it on the sign-in screen).
#    The VITE_* values are BUILD-TIME (baked into the web bundle on `--build`).
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON=      # the service-account JSON, inline (single line)
# FIREBASE_TENANT_CLAIM=tenant
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
#    App Check (docs/app-check.md). On the GH-Actions deploy path these come from repo
#    SECRETS, not this file — the web image is built in CI, so a value here is only read
#    when you build on the box. Public reCAPTCHA site key; provider is enterprise|v3.
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# VITE_FIREBASE_APPCHECK_PROVIDER=enterprise

# ── Early-access allowlist. OPTIONAL — leave UNSET for open sign-up. When set to a
#    comma-separated list of emails, ONLY those (email-VERIFIED) users may sign in; every
#    other authenticated user gets a "not available yet" screen. Gates Firebase USER logins
#    only — `nry_` API tokens (CLI/MCP) always work, and public ingress (webhooks, hosted
#    forms/chat, OAuth callbacks) is UNAFFECTED. The API logs the count (not the emails) at
#    boot, so you can confirm the lock is engaged. A misspelled var silently means "open".
# ACCESS_ALLOWED_EMAILS=you@example.com,teammate@example.com

# ── Instance-wide two-factor requirement (#457). OPTIONAL, DEFAULT OFF. Set to `true` and
#    every human (Firebase) session must have completed a second factor — Firebase MFA
#    stamps it into the ID token — or the API answers 403 `mfa_required` and the web app
#    shows an "enrol to continue" screen. `nry_` API tokens (CLI/MCP) and ALL public ingress
#    (webhooks, hosted forms/chat, OAuth callbacks, signed approve/reject links, /healthz,
#    /metrics) are UNAFFECTED.
#    ⚠️ ENABLE MFA IN YOUR FIREBASE PROJECT AND ENROL YOURSELF FIRST — flipping this on with
#    nobody enrolled locks every human out of the UI (recover by unsetting it and
#    redeploying; `nry_` tokens keep working meanwhile). The API logs the state at boot.
# REQUIRE_MFA=true

# ── SAML SSO (#455, docs/design/SAML-SSO.md). OPTIONAL, DEFAULT OFF. All THREE are required
#    to turn it on; with any missing, /sso/metadata answers 503 and no SAML login can complete.
#    SSO_SESSION_SECRET signs the `nrys_` session the ACS hands the browser — 32+ chars,
#    `openssl rand -hex 32`; a shorter value is REFUSED (SSO stays disabled). SSO_SP_ENTITY_ID
#    and SSO_ACS_URL must match exactly what the IdP admin entered (they are the audience and
#    recipient we verify), so they are explicit — never derived from a request Host.
#    Coexists with Firebase: SAML is a second identity source, subject to the SAME
#    ACCESS_ALLOWED_EMAILS and REQUIRE_MFA policies. Under REQUIRE_MFA a SAML session counts
#    as two-factor only if the IdP asserts a multi-factor AuthnContextClassRef.
#    Each workspace then maps its IdP via PUT /tenants/:id/sso (owner/admin).
#    NOT YET EXERCISED AGAINST A LIVE IdP — assertions are verified only against locally
#    signed test assertions.
# SSO_SESSION_SECRET=          # openssl rand -hex 32
# SSO_SP_ENTITY_ID=https://api.naar-y.com/sso/metadata
# SSO_ACS_URL=https://api.naar-y.com/sso/saml/acs
# SSO_SESSION_TTL_SECONDS=28800
#
#    Each workspace's IdP is registered by an OPERATOR (checks the domain claim first):
#      docker compose exec api node -r @swc/register src/sso/register-sso-connection.ts \
#        <tenantId> <slug> <idpEntityId> <idpSsoUrl> <certFile> <domain[,domain…]> [role]
#    Set SSO_SELF_SERVICE=true only if you accept that any workspace admin may then declare
#    which email domains their own certificate is allowed to assert (PUT /tenants/:id/sso).
# SSO_SELF_SERVICE=false

# ── Object storage. Used for large-payload claim-checks AND hosted-form logo uploads.
#    Omitting it leaves the in-memory store, which is fine for claim-checks in a smoke test but
#    makes logo uploads fail closed with a 503 — deliberately, since a logo held in one api
#    process's heap would vanish on the next rolling deploy and differ per replica.
#    REQUIRED if you want form logos. Works with S3 or any S3-compatible provider (R2/B2/MinIO):
# STORAGE_PROVIDER=s3
# S3_BUCKET=naary-claimchecks
# AWS_REGION=auto                     # R2/B2 use "auto"/their region
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                        # set for R2/B2 (S3-compatible); omit for AWS S3

# ── Platform operators (the Workers fleet view) ───────────────────────────────────────
#    Comma-separated emails of whoever OPERATES this deployment — distinct from whoever owns a
#    workspace inside it. Gates infra telemetry that spans every tenant: the Workers screen shows
#    hostnames, PIDs, worker versions and live slot usage for the whole fleet.
#
#    FAIL CLOSED: leave this unset and NOBODY sees it (the API 403s and the nav entry is hidden).
#    That is deliberate — the check it replaced accepted any workspace owner/admin, which in a
#    multi-tenant deployment is every customer. Self-hosting? Put your own email here.
# PLATFORM_OPERATORS=you@example.com,ops@example.com

# ── Optional observability (Sentry) ──────────────────────────────────────────────────
#   SENTRY_DSN         → backend SHARED fallback (api + worker). Enables errors AND — once
#                        the sample rate below is > 0 — performance spans (method/activity/
#                        Prisma), plus pino logs → Sentry Logs and domain/runtime metrics.
#                        Runtime env; every event/span/log is scrubbed of secrets.
#   SENTRY_DSN_API     → give the API its OWN Sentry project (overrides SENTRY_DSN for it).
#   SENTRY_DSN_WORKER  → same for BOTH worker pools (worker + worker-heavy).
#                        A per-app project buys you per-app issue streams, alert rules,
#                        ownership and quota. Unset ⇒ that app falls back to SENTRY_DSN, and
#                        the `component` tag still separates them inside one project.
#                        NOTE: the sandbox-runner is deliberately NOT instrumented — it is
#                        the container holding Docker access, kept dependency-minimal on
#                        purpose (docs/design/CLAUDE-CODE-NODE.md §8b.1). Its failures
#                        surface as worker activity failures.
#   VITE_SENTRY_DSN    → the browser SPA. BUILD-TIME (baked in on `--build`). This is a
#                        PUBLISHABLE DSN (safe in the client bundle) — use a SEPARATE
#                        Sentry project from the backend so front/back issues don't mix.
#   Leave any unset ⇒ Sentry stays OFF for that side. All default to disabled.
# SENTRY_DSN=
# SENTRY_DSN_API=                      # optional: the API's own project
# SENTRY_DSN_WORKER=                   # optional: the workers' own project
# SENTRY_TRACES_SAMPLE_RATE=0          # backend span sample rate (0 = spans OFF; try 0.1 in prod)
# SENTRY_RELEASE=                      # release tag for backend events (e.g. git sha)
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1   # browser tracing sample rate (0 = off)
# VITE_APP_VERSION=                    # release tag for the SPA (e.g. git sha)
# LOG_LEVEL=info
#   NOTE: Sentry LOGS + METRICS flow automatically once SENTRY_DSN is set. Whether Sentry
#   INGESTS custom metrics depends on your Sentry project/plan (the SDK sends regardless).

# ── Optional OTLP metrics export (Datadog / OpenTelemetry, #462) ──────────────────────
#   Dual-emits the same domain + runtime metrics to an OTLP endpoint (Datadog via its OTLP
#   intake, or any OTel collector). OFF unless OTEL_EXPORTER_OTLP_ENDPOINT is set — when
#   unset, no exporter is constructed and behavior is identical to today (no network/cost).
#   Metric attributes are scrubbed on egress; the HEADERS auth (DD-API-KEY) is transport
#   config, not data. Metrics-only for now (logs→OTLP is a later slice).
# OTEL_EXPORTER_OTLP_ENDPOINT=          # e.g. http://otel-collector:4318 (Datadog Agent OTLP intake)
# OTEL_EXPORTER_OTLP_HEADERS=           # e.g. DD-API-KEY=<key> (comma-separated k=v pairs)
# OTEL_EXPORTER_OTLP_PROTOCOL=          # http/protobuf (default for the http exporter)

# ── Feature flags (optional; OpenFeature + Flagsmith) ────────────────────────────────
#   Unset ⇒ flags OFF: every flag resolves to its SAFE code default (packages/flags catalog),
#   and API boot never blocks on Flagsmith. Set the SERVER-SIDE environment key (`ser.` prefix)
#   to turn them on — it stays on the SERVER (never the browser bundle); the SPA reads its
#   tenant's flags via GET /me/flags. Point FLAGSMITH_API_URL at a self-hosted Flagsmith,
#   or omit for Flagsmith SaaS. (Standing up the self-hosted Flagsmith container is a
#   follow-up; the code is fail-safe without it.)
# FLAGSMITH_ENVIRONMENT_KEY=ser.xxxxxxxxxxxxxxxxxxxxxx
# FLAGSMITH_API_URL=https://flags.internal/api/v1/   # self-hosted only; omit for SaaS

# ── GitHub App (optional; enables `github_app` connections instead of PATs) ────────────
#   Platform-level app credentials — ONE app per deployment, NOT per tenant. Register a
#   GitHub App, then set these. Unset ⇒ github_app connections are unavailable (PATs still work).
#   The private key is the .pem GitHub generates (PKCS#1, `-----BEGIN RSA PRIVATE KEY-----`).
#   In a single-line env var, keep the newlines as literal `\n` (the app un-escapes them).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_APP_SLUG=naary          # the app's URL slug — for the github.com install URL
# GITHUB_APP_CLIENT_ID=          # for the install/OAuth flow (later slice)
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=

# ── Backup target for deploy/backup.sh (optional; uses rclone if set) ────────────────
# BACKUP_RCLONE_REMOTE=r2:naary-backups     # an rclone remote:bucket (R2/B2/S3)

# ── Netdata host/container monitor (docker-compose.prod.yml) — OPTIONAL ───────────────
#    The dashboard is published on the box LOOPBACK only; view it via an SSH tunnel:
#      ssh -L 19999:localhost:19999 root@<box>   →  http://localhost:19999
#    To ALSO see it in Netdata Cloud (no inbound port), create a Space + Room at
#    app.netdata.cloud → "Connect Nodes" and paste the claim token/room id here. Leave
#    empty to stay SSH-tunnel-only.
# NETDATA_CLAIM_TOKEN=
# NETDATA_CLAIM_ROOMS=          # comma-separated room id(s) from the claim dialog

# ── codeAgent sandbox runner (docker-compose.prod.yml, profile `sandbox`) — OPTIONAL ───
#    The runner is the ONE container with the Docker socket: it launches the ephemeral,
#    egress-isolated containers the codeAgent node edits code in. It is profile-gated
#    because it REFUSES to boot without a token, so leaving these unset is the safe
#    default — the app is unaffected, codeAgent keeps running read-only in the worker.
#
#    To enable, on the box:
#      1. docker build -t naary-claude-sandbox:latest /opt/naary/deploy/sandbox
#      2. /opt/naary/deploy/sandbox/egress-test.sh    # acceptance gate: Anthropic only
#      3. set the two vars below, then re-run the deploy (or `docker compose … up -d`)
#    The runner is never publicly reachable (no published port); the worker dials it
#    in-network at SANDBOX_RUNNER_URL and authenticates with SANDBOX_RUNNER_TOKEN.
#
#    Enabling codeAgent WRITE mode (CODE_AGENT_WRITE_ENABLED=true) is a separate, later
#    step — do it only after the egress gate above passes on this host.
# COMPOSE_PROFILES=sandbox      # starts sandbox-runner + its allowlist proxy
# SANDBOX_RUNNER_TOKEN=         # shared bearer token, e.g. `openssl rand -hex 32`
# SANDBOX_RUNNER_URL=http://sandbox-runner:8099   # default; in-network, never public
# SANDBOX_RUNS_DIR=/var/lib/naary/sandbox-runs    # shared working-tree bind mount; the
#                               # SAME path on the host, the worker, and the runner
# CODE_AGENT_WRITE_ENABLED=true # THE write gate. Only after egress-test.sh passes HERE:
#                               # write mode clones a real repo and pushes commits/PRs, and
#                               # the allowlist is what keeps a hijacked run from posting the
#                               # Anthropic key out. Anything but "true" is off.
# CODE_AGENT_SANDBOX_READ=true  # READ-mode isolation (#594/#680). Off ⇒ a read-mode codeAgent
#                               # node runs the coding CLI IN the worker process, where an
#                               # attacker-influenced prompt can Read/Glob the worker's own
#                               # filesystem (/proc/<pid>/environ → ENCRYPTION_KEY). On ⇒ read
#                               # dispatches to the sandbox exactly like write. Also requires the
#                               # `sandbox` profile above; read nodes then need `repo` +
#                               # `connectionId` (the sandbox runs on a cloned tree), and only
#                               # the `claude` tool is supported. Anything but "true" is off.

# Resume-from-failed-node (docs/design/RESUME-FROM-FAILED-NODE.md): on a FAILED run the worker stores
# that run's ctx in object storage so the run can be resumed AT the node that died, instead of
# re-running from the trigger and repeating side effects an earlier node already had. Only a
# claim-check REFERENCE is written to Postgres — never run output content.
# Requires STORAGE_PROVIDER=s3: without it getObjectStore() falls back to an in-process store the API
# cannot read, so no snapshot is written and the UI explains that resume is unavailable.
# Set to `off` to disable snapshots entirely (resume then reports why).
# RESUME_SNAPSHOTS=on
