// Prisma schema for naary-orchestrator.
// Postgres owns DEFINITIONS and RECORDS (api tokens, execution ownership, tenant
// credentials, connections, webhooks, budgets, the usage ledger); Temporal owns
// execution STATE. Run from repo root: `pnpm db:migrate` / `pnpm db:generate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection url lives in prisma.config.ts (CLI) and the driver
  // adapter passed to PrismaClient at runtime — not here.
}

// Security hardening — per-tenant API tokens authenticate the control plane;
// Execution records bind a Temporal workflowId to its owning tenant.

model ApiToken {
  id         String    @id @default(uuid())
  tenantId   String
  tokenHash  String    @unique // sha256 hex of the bearer token; plaintext never stored
  label      String
  // Optional env binding (design ENVIRONMENTS.md §3, Slice 4): a token scoped to ONE env (e.g. a
  // CI token → sandbox). Null = unbound (uses the request's X-Environment-Id, else the default).
  // A bound token's env is authoritative — a conflicting header is rejected. SetNull on env delete
  // so a deleted env just unbinds the token (falls back to default) rather than blocking the delete.
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([tenantId])
}

model Execution {
  workflowId  String   @id // Temporal workflowId
  tenantId    String
  // The env this run executed in (design ENVIRONMENTS.md Slice 6) — a read-model TAG for per-env
  // Runs visibility + resolving a run's graph in its own env (approval-prompt/re-run). Nullable: a
  // pre-Slice-6 run has none (falls back to the default env), and no FK — a historical record must
  // not block env deletion, and a dangling id degrades gracefully (best-effort display reads).
  environmentId String?
  workflowKey String? // the graph key this run started (null for pre-migration rows)
  // The GraphDefinition.version this run snapshotted at start — shown on the Runs list /
  // run detail, and the anchor for "re-run at a chosen version". NULL for pre-migration
  // rows and any run whose version wasn't recorded (the memo/history still holds it).
  graphVersion Int?
  // Read-model projection pushed by the interpreter (Temporal stays the source of
  // truth) so the Runs list is a single PG read — no per-run Temporal RPCs.
  status      String   @default("running")
  costUsd     Decimal? @db.Decimal(12, 6)
  createdAt   DateTime @default(now())
  // Soft-archive: a user hides a run from the Runs list without deleting it. NULL = active
  // (the default view); non-null = archived + when. Purely a read-model flag — no Temporal
  // interaction, and the worker's status/cost pushes never touch it.
  archivedAt  DateTime?

  // Runs list = `where {tenantId, archivedAt IS [NOT] NULL} orderBy createdAt desc`.
  // For the DEFAULT view (archivedAt IS NULL — an equality), (tenantId, archivedAt, createdAt)
  // serves the filter AND the createdAt sort from one index. For the ARCHIVED view
  // (archivedAt IS NOT NULL — a range), the index still narrows the filter but createdAt isn't
  // the leading sort key, so PG may add a sort; acceptable (archived is the rarer view). The
  // (tenantId, createdAt) index covers any non-archive-filtered read.
  @@index([tenantId, createdAt])
  @@index([tenantId, archivedAt, createdAt])
}

// Recurring runs: a Temporal Schedule (cron) that starts a workflow. The row is
// the tenant-scoped index/registry; Temporal owns the schedule + its firing.
model Schedule {
  id          String   @id // the Temporal scheduleId
  tenantId    String
  workflowKey String // which saved graph it runs
  cron        String // cron expression
  paused      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

// Change-detection cursor for a pollTrigger node. One row per (tenant, workflow,
// node): the last-seen change key. A poll run compares the freshly-fetched key to
// this and only fires downstream when it differs, then upserts the new key. Keyed by
// workflowKey (not executionId) so it persists ACROSS the scheduled runs.
model PollState {
  tenantId    String
  workflowKey String
  nodeId      String
  lastKey     String // sha256 of the change value (or the whole body)
  updatedAt   DateTime @updatedAt

  @@id([tenantId, workflowKey, nodeId])
}

// Versioned graph definitions (Slice #5). Postgres owns graph DEFINITIONS; each
// run snapshots an immutable version (content-hashed) so editing a flow can't
// corrupt an in-flight execution.
model GraphDefinition {
  id          String   @id @default(uuid())
  tenantId    String
  // Env-scoped (design ENVIRONMENTS.md Slice 2b): a workflow definition lives in ONE environment.
  // The same workflowKey can exist independently per env (copy-on-promote). Backfilled to each
  // tenant's default "prod" env.
  environmentId String
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  workflowKey String // stable key the trigger/registry referenced, e.g. "github-review"
  name        String
  graph       Json // the GraphDef
  contentHash String // sha256 of canonical(graph)
  version     Int // monotonically increasing per (tenantId, environmentId, workflowKey)
  createdAt   DateTime @default(now())

  @@unique([tenantId, environmentId, workflowKey, version])
  @@index([tenantId, environmentId, workflowKey])
}

/** Copy-on-promote lineage (design ENVIRONMENTS.md §6, Slice 3): one audit row per promote of a
 *  workflow definition from one env to another. Records WHO promoted WHAT, WHEN, and the source→
 *  target versions — the substrate RBAC's "who can promote to prod" enforcement + audit builds on.
 *  Creds/connections are NOT copied on promote; only the graph definition is. */
model Promotion {
  id          String   @id @default(uuid())
  tenantId    String
  workflowKey String
  fromEnvId   String
  toEnvId     String
  fromVersion Int
  toVersion   Int // the version created (or reused, if identical) in the target env
  actor       String // OIDC subject, or "api-token"
  createdAt   DateTime @default(now())

  // Includes createdAt so the lineage read (`where {tenantId, workflowKey} order by createdAt desc`)
  // is served by the index without a separate sort (mirrors AuditEvent).
  @@index([tenantId, workflowKey, createdAt])
}

/** Pinned node output — AUTHORING-ONLY sample data (design SINGLE-NODE-EXECUTION.md §4). Lets you
 *  build downstream nodes against a saved output without re-running upstream. The interpreter NEVER
 *  reads this (a real run always executes upstream) — it's a dev aid, invisible to production. */
model PinnedData {
  tenantId    String
  workflowKey String
  nodeId      String
  output      Json // the pinned sample (keep small; large blobs use the claim-check store)
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([tenantId, workflowKey, nodeId])
  @@index([tenantId, workflowKey])
}

/** Per-workflow error-handler binding: when the run for `workflowKey` fails, the
 *  interpreter starts the graph saved under `errorWorkflowKey` (detached) with the
 *  failure context. One row per (tenant, workflowKey); absence = no handler. */
model ErrorHandler {
  tenantId         String
  workflowKey      String
  errorWorkflowKey String
  updatedAt        DateTime @default(now()) @updatedAt

  @@id([tenantId, workflowKey])
}

/** Per-workflow activation flag (n8n parity). When a workflow is INACTIVE its automatic triggers
 *  don't fire: webhook/form ingress is refused, and its Temporal cron/poll schedules are paused.
 *  Manual runs are always allowed. One row per (tenant, workflowKey); ABSENCE ⇒ ACTIVE — a
 *  deliberate divergence from n8n's default-inactive, so existing webhooks/schedules keep working
 *  (the toggle's value is the pause capability). Don't "fix" this default to inactive. */
model WorkflowActivation {
  tenantId    String
  // Env-scoped (design ENVIRONMENTS.md Slice 2b): the active flag is per-env, so toggling a
  // workflow in sandbox doesn't (de)activate the same key in prod. Backfilled to the default env.
  environmentId String
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  workflowKey String
  active      Boolean  @default(true)
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([tenantId, environmentId, workflowKey])
}

// Slice #4 — external integrations.

model WebhookEndpoint {
  id            String   @id @default(uuid())
  workflowId    String // which graph to start (graphs are hardcoded for now)
  tenantId      String
  // Env-bound (design ENVIRONMENTS.md §3, Slice 4): a webhook fires runs in ITS env — the endpoint's
  // env wins. Set at registration from the registering user's active env; backfilled to default.
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  provider      String // 'github' | 'atlassian' | 'generic'
  signingSecret String // plain column per plan §4 (HMAC secret; never logged)
  createdAt     DateTime @default(now())

  @@index([tenantId, environmentId])
}

// A hosted public form that starts a workflow (formTrigger). Unlike a webhook there is
// NO signing secret — a form is intentionally anonymous, so the opaque `id` is the only
// capability (don't leak tenantId/workflowId in the public URL). The form's field schema
// is NOT stored here; it's read live from the current graph's formTrigger node so the
// hosted form always reflects the latest definition.
model FormEndpoint {
  id         String   @id @default(uuid())
  workflowId String // which graph (workflowKey) this form starts
  tenantId   String
  // Env-bound (Slice 4): the form fires runs in its env. Backfilled to the default env.
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([tenantId, environmentId])
}

// A hosted public chat (chatTrigger) that starts a workflow per message. Like FormEndpoint there is
// NO secret — the opaque `id` is the only capability; the widget config is read live from the graph's
// chatTrigger node. (design docs/design/CHAT-TRIGGER-RAG.md)
model ChatEndpoint {
  id         String   @id @default(uuid())
  workflowId String // which graph (workflowKey) this chat starts
  tenantId   String
  // Env-bound (Slice 4): the chat fires runs in its env. Backfilled to the default env.
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([tenantId, environmentId])
}

// Cross-message chat memory (design CHAT-TRIGGER-RAG.md §2.1b, option B): TWO rows per turn (a user
// row + an assistant row), keyed by (chat, session). Threaded into each per-message run so the agent
// has conversation context — a strict prefix of the durable-session-workflow (option A), upgradeable
// later with no lock-in. `seq` (BIGSERIAL) gives a total, monotonic insertion order so ordering is
// deterministic even when two rows share a millisecond `createdAt`.
model ChatMessage {
  id        String   @id @default(uuid())
  seq       BigInt   @default(autoincrement())
  tenantId  String
  chatId    String
  sessionId String
  role      String // "user" | "assistant"
  text      String
  createdAt DateTime @default(now())

  @@index([tenantId, chatId, sessionId, seq])
}

// RAG: a tenant-scoped vector store for the vectorUpsert / vectorQuery nodes (pgvector). The
// `embedding` column is a raw `vector(1536)` (OpenAI text-embedding-3-small) added in the migration;
// `Unsupported` keeps Prisma aware of it without generating a client field — it's read/written via
// raw SQL in the activity. Exact cosine search (`<=>`) for v1; no ivfflat index yet.
model VectorChunk {
  id         String                      @id @default(uuid())
  tenantId   String
  collection String // logical namespace within the tenant (e.g. "docs", "faq")
  chunkText  String
  embedding  Unsupported("vector(1536)")
  metadata   Json?
  createdAt  DateTime                    @default(now())

  @@index([tenantId, collection])
}

// Delivery-id dedupe so provider retries don't start duplicate executions.
model WebhookDelivery {
  id         String   @id @default(uuid())
  endpointId String
  deliveryId String
  createdAt  DateTime @default(now())

  @@unique([endpointId, deliveryId])
  // The retention prune is `where {endpointId, createdAt < cutoff}` — index the
  // range so the sweep doesn't scan the endpoint's whole delivery history (A-4).
  @@index([endpointId, createdAt])
}

model Connection {
  id        String   @id @default(uuid())
  tenantId  String
  // Env-scoped (design ENVIRONMENTS.md §3, Slice 5): a sandbox run binds to sandbox connections,
  // prod to prod — separate live/test integrations. Backfilled to the tenant's default env.
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  type      String // 'atlassian' | 'github' | 'custom'
  label     String
  serverUrl String // e.g. https://mcp.atlassian.com/v1/mcp
  authMode  String // 'api_token' | 'pat' | 'oauth'
  scopes    String[]
  status    String   @default("connected") // 'connected' | 'needs_reauth' | 'error'
  // secret/refresh token stored via the Slice #2 encrypted credential store, keyed by this id
  createdAt DateTime @default(now())

  @@unique([tenantId, environmentId, type, label])
}

model TenantBudget {
  id                 String  @id @default(uuid())
  tenantId           String  @unique
  monthlyCapUsd      Decimal @db.Decimal(12, 2)
  perExecutionCapUsd Decimal @db.Decimal(12, 2)
  maxStepsPerRun     Int     @default(50) // circuit breaker
  onBudgetExceeded   String  @default("reject") // 'reject' | 'downgrade'
  fallbackModel      String? // used when policy = 'downgrade'
}

model TenantCredential {
  id              String    @id @default(uuid())
  tenantId        String
  // Env-scoped (design ENVIRONMENTS.md §3, Slice 5): separate BYOK/provider keys per env — a sandbox
  // run uses test keys, prod live keys. Backfilled to the tenant's default env. NB the at-rest AAD
  // stays bound to `${tenantId}:${provider}` (NOT env) — env is a row-lookup concern, not a crypto
  // one, so backfilled rows still decrypt.
  environmentId   String
  environment     Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  provider        String // 'anthropic' | 'openai' | 'google' | 'ollama'
  ciphertext      String // base64 AES-256-GCM ciphertext
  iv              String // base64 nonce
  authTag         String // base64 GCM auth tag
  keyVersion      Int       @default(1) // at-rest format: 1 = legacy (no AAD), 2 = AAD-bound (Sec#7)
  isValid         Boolean   @default(false)
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())

  @@unique([tenantId, environmentId, provider])
}

model UsageEvent {
  id                String   @id @default(uuid())
  tenantId          String
  // Per-env cost VISIBILITY tag (design ENVIRONMENTS.md Slice 6). Nullable + no FK — billing stays
  // ONE bill per tenant: the budget aggregate/reservation/gate all sum across envs and never read
  // this column. It exists only so spend can later be BROKEN DOWN by env, never enforced by it.
  environmentId     String?
  executionId       String // Temporal workflowId
  nodeId            String
  provider          String
  model             String
  inputTokens       Int
  outputTokens      Int
  totalTokens       Int
  cachedInputTokens Int      @default(0)
  reasoningTokens   Int      @default(0)
  costUsd           Decimal  @db.Decimal(12, 6)
  createdAt         DateTime @default(now())

  @@unique([executionId, nodeId]) // idempotent ledger: a retried activity can't double-write
  @@index([tenantId, createdAt])
  @@index([executionId])
}

// In-flight cost reservations (Arch§4.3). A run reserves its estimated cost
// BEFORE the LLM call and releases it after recording the actual UsageEvent, so
// concurrent runs for one tenant can't all overshoot the monthly cap. Dangling
// reservations (crash mid-call) stop counting after a short TTL.
model UsageReservation {
  id               String   @id @default(uuid())
  tenantId         String
  estimatedCostUsd Decimal  @db.Decimal(12, 6)
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Per-tenant ENVIRONMENT (design docs/design/ENVIRONMENTS.md) — sandbox / UAT / prod as fully
// separate spaces. Slice 1 is the entity + management only; env-SCOPING of workflows/runs/creds
// lands in later slices behind a `envId ?? default` compatibility shim. Exactly one `isDefault`
// per tenant (the "Production" env holding all pre-environments data); created lazily on first
// access (upsert on the unique slug — race-safe), so no backfill across implicit tenants is needed.
model Environment {
  id        String   @id @default(uuid())
  tenantId  String
  name      String // display: "Sandbox", "UAT", "Production"
  slug      String // stable, header/URL-safe: "sandbox", "uat", "prod"
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  graphDefinitions    GraphDefinition[]
  workflowActivations WorkflowActivation[]
  apiTokens           ApiToken[]
  webhookEndpoints    WebhookEndpoint[]
  formEndpoints       FormEndpoint[]
  chatEndpoints       ChatEndpoint[]
  connections         Connection[]
  tenantCredentials   TenantCredential[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  // NB: a PARTIAL unique index `("tenantId") WHERE "isDefault"` (in the migration, not expressible
  // in Prisma's DSL) enforces exactly one default env per tenant at the DB level.
}

// Workspace members (Team screen). Lightweight directory keyed by tenant; auth
// itself is Keycloak/API-token (this is not the identity source of truth).
model Member {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  role      String   @default("member") // 'owner' | 'admin' | 'member'
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

// Multi-workspace membership (design: PROVISIONING-MULTIUSER.md). The AUTHORITY for
// which workspaces a user belongs to + their role — a user has one row per workspace.
// `userId` is the Firebase uid. Resolved per-request through MembershipCache; this
// table is the source of truth. (The guard does NOT enforce against this yet — added
// in a later slice; today it's populated + read by /me/workspaces only.)
model Membership {
  id        String   @id @default(uuid())
  userId    String // Firebase uid
  tenantId  String
  role      String   @default("member") // 'owner' | 'admin' | 'member'
  email     String? // the user's email at join time (directory convenience)
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

// Per-tenant settings (Settings screen). One row per tenant.
/// Non-secret per-workspace config, ENV-SCOPED, referenced in string expressions as
/// `{{ $vars.KEY }}`. The worker loads a workspace+env's variables into the run ctx under `$vars`
/// at start (as DATA), so a value can differ per environment (e.g. a URL in sandbox vs prod). NOT
/// for secrets — those resolve in-activity and never enter the graph/ctx/history (separate feature).
model Variable {
  tenantId      String
  environmentId String
  key           String
  value         String
  updatedAt     DateTime @default(now()) @updatedAt

  @@id([tenantId, environmentId, key])
  @@index([tenantId, environmentId])
}

model TenantSettings {
  tenantId     String   @id
  displayName  String?
  defaultModel String? // e.g. 'claude-opus-4-8'
  // Nullable link to the org (Company) this workspace belongs to (COMPANIES.md). Additive:
  // standalone workspaces leave it null. onDelete: SetNull — deleting a company detaches, not
  // cascades. Company is NOT an isolation dimension; no tenantId-scoped query reads this.
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([companyId])
}

/// An org grouping workspaces for cross-workspace admin + billing/usage rollup (COMPANIES.md).
/// NOT an isolation boundary — every tenantId-scoped query is unchanged; Company only adds a
/// cross-workspace authorization + read-model path on top.
model Company {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  createdAt   DateTime            @default(now())
  memberships CompanyMembership[]
  workspaces  TenantSettings[]
}

/// A user's role IN A COMPANY (distinct from the per-workspace Membership). Keyed by Firebase uid.
/// Grants the cross-workspace admin path; grants NO implicit per-workspace membership.
model CompanyMembership {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String // Firebase uid
  role      String   @default("admin") // 'owner' | 'admin'
  createdAt DateTime @default(now())

  @@id([companyId, userId])
  @@index([userId])
}

// Per-tenant notification settings. A run notifies (best-effort) via an outbound
// webhook POST when an approval is pending or a run fails — so a HITL flow that can
// pause for days actually reaches a human. One row per tenant; absence = off.
// DORMANT — superseded by NotificationChannel (per-channel, independently configurable). Kept
// (not dropped) for one release so an old worker mid-rolling-deploy can still read it; the
// notification_channels migration BACKFILLS its rows into NotificationChannel. Drop in a later
// migration once every worker/api replica reads NotificationChannel.
model NotificationSettings {
  tenantId          String   @id
  webhookUrl        String? // POST target (Slack/Teams/generic incoming webhook)
  // Which payload format to send to webhookUrl. "slack" = Block Kit (default, back-compat);
  // "teams" = an Adaptive Card in the {type:"message",attachments:[…]} envelope that a Teams
  // Workflows/Incoming-Webhook renders. The worker branches on this.
  channel           String   @default("slack")
  onApprovalPending Boolean  @default(true)
  onRunFailed       Boolean  @default(true)
  updatedAt         DateTime @default(now()) @updatedAt
}

// One row per (tenant, channel type) — Slack, Teams, and (later) email each configured and
// toggled INDEPENDENTLY, so a run-failed alert can fan out to several at once rather than the
// old either/or `NotificationSettings.channel`. The worker reads all `enabled` rows and POSTs
// each, formatting per `type`. Event routing is per-channel (send failures to Slack, approvals
// to Teams, …). `@@unique([tenantId, type])` = one config per type for now; `id` is a standalone
// uuid so that can be relaxed later without a data migration.
model NotificationChannel {
  id                String   @id @default(uuid())
  tenantId          String
  type              String // "slack" | "teams" | (future: "email")
  enabled           Boolean  @default(true)
  webhookUrl        String? // POST target for slack/teams; null for channels that don't use one
  // Channel-specific settings a URL can't hold (e.g. email recipients). Null + unused for
  // slack/teams — reserved for the coming email/other channels, not invented structure now.
  config            Json?
  onApprovalPending Boolean  @default(true)
  onRunFailed       Boolean  @default(true)
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([tenantId, type])
  @@index([tenantId])
}

// Per-USER preferences — personal + cross-workspace, so they follow a user across
// devices (unlike TenantSettings, which is per-workspace). Keyed by Firebase uid.
// Today: `mode` (Builder vs Simple experience, design PRODUCT-VARIANTS.md). Absent
// row = client default. API-token principals have no uid, so they stay client-only.
model UserPreference {
  userId    String   @id // Firebase uid
  mode      String? // 'builder' | 'simple' — the experience variant
  // Customizable Overview layout: an ordered array of { id, hidden, span } widget
  // entries. Null = never customized → the client uses the default layout.
  dashboard Json?
  updatedAt DateTime @default(now()) @updatedAt
}

// Append-only audit log: who did what, when (the activity feed). One row per
// successful mutating request, written by the AuditInterceptor. `actor` is the OIDC
// subject (or "api-token"); `action` is a human label derived from method+route.
model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  actor      String // OIDC subject, or "api-token"
  action     String // human label, e.g. "Saved a workflow"
  method     String // HTTP method
  path       String // request path (no query)
  statusCode Int
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}
