// Prisma schema for naary-orchestrator.
// Postgres owns DEFINITIONS and RECORDS (api tokens, execution ownership, tenant
// credentials, connections, webhooks, budgets, the usage ledger); Temporal owns
// execution STATE. Run from repo root: `pnpm db:migrate` / `pnpm db:generate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection url lives in prisma.config.ts (CLI) and the driver
  // adapter passed to PrismaClient at runtime — not here.
}

// Security hardening — per-tenant API tokens authenticate the control plane;
// Execution records bind a Temporal workflowId to its owning tenant.

model ApiToken {
  id         String    @id @default(uuid())
  tenantId   String
  tokenHash  String    @unique // sha256 hex of the bearer token; plaintext never stored
  label      String
  // Optional env binding (design ENVIRONMENTS.md §3, Slice 4): a token scoped to ONE env (e.g. a
  // CI token → sandbox). Null = unbound (uses the request's X-Environment-Id, else the default).
  // A bound token's env is authoritative — a conflicting header is rejected. SetNull on env delete
  // so a deleted env just unbinds the token (falls back to default) rather than blocking the delete.
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  // Group membership as an RBAC subject (RBAC-GROUPS.md §4a): a restricted token's grants
  // resolve through these joins. Deleting the token cascades its rows.
  groupMemberships GroupTokenMember[]

  @@index([tenantId])
}

model Execution {
  workflowId  String   @id // Temporal workflowId
  tenantId    String
  // The env this run executed in (design ENVIRONMENTS.md Slice 6) — a read-model TAG for per-env
  // Runs visibility + resolving a run's graph in its own env (approval-prompt/re-run). Nullable: a
  // pre-Slice-6 run has none (falls back to the default env), and no FK — a historical record must
  // not block env deletion, and a dangling id degrades gracefully (best-effort display reads).
  environmentId String?
  workflowKey String? // the graph key this run started (null for pre-migration rows)
  // The GraphDefinition.version this run snapshotted at start — shown on the Runs list /
  // run detail, and the anchor for "re-run at a chosen version". NULL for pre-migration
  // rows and any run whose version wasn't recorded (the memo/history still holds it).
  graphVersion Int?
  // Read-model projection pushed by the interpreter (Temporal stays the source of
  // truth) so the Runs list is a single PG read — no per-run Temporal RPCs.
  status      String   @default("running")
  costUsd     Decimal? @db.Decimal(12, 6)
  // Searchable projection of the run's TRIGGER INPUT (issue #463 "search executions by contained
  // data") — the user-supplied structured data the run was started with, serialized + length-capped
  // at start (see startGraph). It is NOT LLM prompt/completion text and NOT node outputs (those are
  // Temporal-only and, for agent nodes, ARE completion text the privacy rule forbids indexing). Null
  // for pre-migration rows and for worker-created scheduled runs (their input is typically static).
  // Substring search (`?q=`) runs against this column, served by a pg_trgm GIN index that the
  // migration hand-authors (not expressible in the Prisma schema without preview extensions).
  searchText  String?
  createdAt   DateTime @default(now())
  // When the run reached a TERMINAL status (Slice 2 — per-node timing + cost). Stamped
  // in-activity (setExecutionStatus) on the terminal push, so durationMs = finishedAt −
  // createdAt is derivable in one PG read. NULL for in-flight runs AND for runs that
  // predate this column (or closed at the Temporal level without a terminal push, e.g.
  // user-terminated) — consumers must render "—", never fabricate.
  finishedAt  DateTime?
  // Compact failure classification on terminal FAILED runs (Slice 2):
  // timeout | upstream_5xx | rate_limit | budget | rejected | error. Derived in the worker
  // from the failure the interpreter/activity already observed (never re-parsed later).
  // NULL for successes, in-flight runs, and pre-feature rows — consumers fall back to the
  // close status.
  failureKind String?
  // Slice 3 (budget pause-not-fail): when the run last entered `awaiting_budget` (stamped
  // in-activity by setExecutionStatus, cleared on any other status push). The month-rollover
  // boot reconcile signals `budgetResume` to awaiting_budget rows whose pause month < the
  // current month. NULL = not currently paused on budget.
  budgetPausedAt DateTime?
  // Soft-archive: a user hides a run from the Runs list without deleting it. NULL = active
  // (the default view); non-null = archived + when. Purely a read-model flag — no Temporal
  // interaction, and the worker's status/cost pushes never touch it.
  archivedAt  DateTime?
  // Run-detail failed-run recovery (#525): a THROWN workflow's ctx isn't queryable after close,
  // so the interpreter stamps, on the failure path, which node it died on + which nodes had run.
  // Node IDs ONLY — never ctx output content (privacy checklist). failedNodeId NULL unless the
  // run threw; executedNodeIds empty for non-thrown/pre-feature runs (the UI falls back to ctx).
  failedNodeId    String?
  executedNodeIds String[]

  // Runs list = `where {tenantId, archivedAt IS [NOT] NULL} orderBy createdAt desc`.
  // For the DEFAULT view (archivedAt IS NULL — an equality), (tenantId, archivedAt, createdAt)
  // serves the filter AND the createdAt sort from one index. For the ARCHIVED view
  // (archivedAt IS NOT NULL — a range), the index still narrows the filter but createdAt isn't
  // the leading sort key, so PG may add a sort; acceptable (archived is the rarer view). The
  // (tenantId, createdAt) index covers any non-archive-filtered read.
  @@index([tenantId, createdAt])
  @@index([tenantId, archivedAt, createdAt])
}

// Recurring runs: a Temporal Schedule (cron) that starts a workflow. The row is
// the tenant-scoped index/registry; Temporal owns the schedule + its firing.
model Schedule {
  id          String   @id // the Temporal scheduleId (env-scoped: poll-<tenant>-<env>-<wf> etc.)
  tenantId    String
  // Env-scoped (ENVIRONMENTS.md §7, env-scoped-schedules slice): the env is part of the schedule
  // IDENTITY — a sandbox poll schedule fires sandbox's graph, never prod's. Cascade: schedules are
  // disposable trigger config and must not block env deletion (the Temporal handle is torn down
  // best-effort by EnvironmentsService/sync — a missing row means nothing fires against the graph).
  environmentId String
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  workflowKey String // which saved graph it runs
  cron        String // cron expression
  paused      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, environmentId])
}

// Change-detection cursor for a pollTrigger node. One row per (tenant, env, workflow,
// node): the last-seen change key. A poll run compares the freshly-fetched key to
// this and only fires downstream when it differs, then upserts the new key. Keyed by
// workflowKey (not executionId) so it persists ACROSS the scheduled runs; env-scoped
// so sandbox's poll cursor never suppresses (or double-fires) prod's.
model PollState {
  tenantId    String
  environmentId String
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  workflowKey String
  nodeId      String
  lastKey     String // sha256 of the change value (or the whole body)
  updatedAt   DateTime @updatedAt

  @@id([tenantId, environmentId, workflowKey, nodeId])
}

// Versioned graph definitions (Slice #5). Postgres owns graph DEFINITIONS; each
// run snapshots an immutable version (content-hashed) so editing a flow can't
// corrupt an in-flight execution.
model GraphDefinition {
  id          String   @id @default(uuid())
  tenantId    String
  // Env-scoped (design ENVIRONMENTS.md Slice 2b): a workflow definition lives in ONE environment.
  // The same workflowKey can exist independently per env (copy-on-promote). Backfilled to each
  // tenant's default "prod" env.
  environmentId String
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  workflowKey String // stable key the trigger/registry referenced, e.g. "github-review"
  name        String
  graph       Json // the GraphDef
  contentHash String // sha256 of canonical(graph)
  version     Int // monotonically increasing per (tenantId, environmentId, workflowKey)
  createdAt   DateTime @default(now())
  // Version-history WHO/WHY (#488). savedBy = a display string for the actor who saved this
  // version (email for a user, "api-token" for a token); NULL for internal/promote copy-in +
  // pre-feature rows (a promoted version's "who" comes from the Promotion lineage instead).
  // saveMessage = an optional commit note (API/CLI-settable). when = createdAt above.
  savedBy     String?
  saveMessage String?

  @@unique([tenantId, environmentId, workflowKey, version])
  @@index([tenantId, environmentId, workflowKey])
}

/** Copy-on-promote lineage (design ENVIRONMENTS.md §6, Slice 3): one audit row per promote of a
 *  workflow definition from one env to another. Records WHO promoted WHAT, WHEN, and the source→
 *  target versions — the substrate RBAC's "who can promote to prod" enforcement + audit builds on.
 *  Creds/connections are NOT copied on promote; only the graph definition is. */
model Promotion {
  id          String   @id @default(uuid())
  tenantId    String
  workflowKey String
  fromEnvId   String
  toEnvId     String
  fromVersion Int
  toVersion   Int // the version created (or reused, if identical) in the target env
  actor       String // OIDC subject, or "api-token"
  createdAt   DateTime @default(now())

  // Includes createdAt so the lineage read (`where {tenantId, workflowKey} order by createdAt desc`)
  // is served by the index without a separate sort (mirrors AuditEvent).
  @@index([tenantId, workflowKey, createdAt])
}

/** Pinned node output — AUTHORING-ONLY sample data (design SINGLE-NODE-EXECUTION.md §4). Lets you
 *  build downstream nodes against a saved output without re-running upstream. The interpreter NEVER
 *  reads this (a real run always executes upstream) — it's a dev aid, invisible to production. */
model PinnedData {
  tenantId      String
  environmentId String
  workflowKey   String
  nodeId        String
  output        Json // the pinned sample (keep small; large blobs use the claim-check store)
  updatedAt     DateTime @default(now()) @updatedAt

  // Cascade (NOT Restrict, unlike Connection/TenantCredential): pins are disposable authoring
  // aids — deleting an environment takes its pins with it rather than 409-blocking the delete.
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  // The PK's left prefix (tenantId, environmentId, workflowKey) also serves the pins-list and
  // delete-workflow queries, so no secondary index is needed.
  @@id([tenantId, environmentId, workflowKey, nodeId])
}

/** Per-workflow error-handler binding: when the run for `workflowKey` fails, the
 *  interpreter starts the graph saved under `errorWorkflowKey` (detached) with the
 *  failure context. One row per (tenant, env, workflowKey); absence = no handler.
 *  Env-scoped (slice-6 cleanup): a sandbox failure triggers sandbox's handler, never prod's. */
model ErrorHandler {
  tenantId         String
  environmentId    String
  workflowKey      String
  errorWorkflowKey String
  updatedAt        DateTime @default(now()) @updatedAt

  // Cascade (NOT Restrict): a binding is disposable config — deleting an environment removes
  // its bindings rather than 409-blocking the delete (same rationale as pins/channels, 6b).
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@id([tenantId, environmentId, workflowKey])
}

/** Per-workflow activation flag (n8n parity). When a workflow is INACTIVE its automatic triggers
 *  don't fire: webhook/form ingress is refused, and its Temporal cron/poll schedules are paused.
 *  Manual runs are always allowed. One row per (tenant, workflowKey); ABSENCE ⇒ ACTIVE — a
 *  deliberate divergence from n8n's default-inactive, so existing webhooks/schedules keep working
 *  (the toggle's value is the pause capability). Don't "fix" this default to inactive. */
model WorkflowActivation {
  tenantId    String
  // Env-scoped (design ENVIRONMENTS.md Slice 2b): the active flag is per-env, so toggling a
  // workflow in sandbox doesn't (de)activate the same key in prod. Backfilled to the default env.
  environmentId String
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  workflowKey String
  active      Boolean  @default(true)
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([tenantId, environmentId, workflowKey])
}

/** Workflow tag (n8n parity, RBAC program slice T1) — ORGANIZATIONAL metadata only. Tags are
 *  NOT permission-bearing today; tag-scoped grants are a documented future seam in the upcoming
 *  RBAC-GROUPS design. Name is unique per tenant; `color` is an optional hex the UI picks from
 *  a fixed palette. */
model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String?  // optional hex; UI offers a fixed palette
  createdAt DateTime @default(now())
  workflows WorkflowTag[]
  tagGrants TagGrant[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Tags attach to (tenantId, workflowKey) TENANT-WIDE, not per env: authoring metadata like
// the workflow's name — identical in every environment, promote carries them implicitly.
// Soft reference (no FK to GraphDefinition — no single row identity across versions/envs).
model WorkflowTag {
  tagId       String
  tag         Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tenantId    String
  workflowKey String
  createdAt   DateTime @default(now())

  @@id([tagId, tenantId, workflowKey])
  @@index([tenantId, workflowKey])
}

// Slice #4 — external integrations.

model WebhookEndpoint {
  id            String   @id @default(uuid())
  workflowId    String // which graph to start (graphs are hardcoded for now)
  tenantId      String
  // Env-bound (design ENVIRONMENTS.md §3, Slice 4): a webhook fires runs in ITS env — the endpoint's
  // env wins. Set at registration from the registering user's active env; backfilled to default.
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  provider      String // 'github' | 'atlassian' | 'generic'
  signingSecret String // plain column per plan §4 (HMAC secret; never logged)
  createdAt     DateTime @default(now())

  @@index([tenantId, environmentId])
}

// A hosted public form that starts a workflow (formTrigger). Unlike a webhook there is
// NO signing secret — a form is intentionally anonymous, so the opaque `id` is the only
// capability (don't leak tenantId/workflowId in the public URL). The form's field schema
// is NOT stored here; it's read live from the current graph's formTrigger node so the
// hosted form always reflects the latest definition.
model FormEndpoint {
  id         String   @id @default(uuid())
  workflowId String // which graph (workflowKey) this form starts
  tenantId   String
  // Env-bound (Slice 4): the form fires runs in its env. Backfilled to the default env.
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([tenantId, environmentId])
}

// A hosted public chat (chatTrigger) that starts a workflow per message. Like FormEndpoint there is
// NO secret — the opaque `id` is the only capability; the widget config is read live from the graph's
// chatTrigger node. (design docs/design/CHAT-TRIGGER-RAG.md)
model ChatEndpoint {
  id         String   @id @default(uuid())
  workflowId String // which graph (workflowKey) this chat starts
  tenantId   String
  // Env-bound (Slice 4): the chat fires runs in its env. Backfilled to the default env.
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([tenantId, environmentId])
}

// Cross-message chat memory (design CHAT-TRIGGER-RAG.md §2.1b, option B): TWO rows per turn (a user
// row + an assistant row), keyed by (chat, session). Threaded into each per-message run so the agent
// has conversation context — a strict prefix of the durable-session-workflow (option A), upgradeable
// later with no lock-in. `seq` (BIGSERIAL) gives a total, monotonic insertion order so ordering is
// deterministic even when two rows share a millisecond `createdAt`.
model ChatMessage {
  id        String   @id @default(uuid())
  seq       BigInt   @default(autoincrement())
  tenantId  String
  chatId    String
  sessionId String
  role      String // "user" | "assistant"
  text      String
  createdAt DateTime @default(now())

  @@index([tenantId, chatId, sessionId, seq])
}

// RAG: a tenant-scoped vector store for the vectorUpsert / vectorQuery nodes (pgvector). The
// `embedding` column is a raw `vector(1536)` (OpenAI text-embedding-3-small) added in the migration;
// `Unsupported` keeps Prisma aware of it without generating a client field — it's read/written via
// raw SQL in the activity. Exact cosine search (`<=>`) for v1; no ivfflat index yet.
model VectorChunk {
  id         String                      @id @default(uuid())
  tenantId   String
  collection String // logical namespace within the tenant (e.g. "docs", "faq")
  chunkText  String
  embedding  Unsupported("vector(1536)")
  metadata   Json?
  createdAt  DateTime                    @default(now())

  @@index([tenantId, collection])
}

// Delivery-id dedupe so provider retries don't start duplicate executions.
model WebhookDelivery {
  id         String   @id @default(uuid())
  endpointId String
  deliveryId String
  createdAt  DateTime @default(now())

  @@unique([endpointId, deliveryId])
  // The retention prune is `where {endpointId, createdAt < cutoff}` — index the
  // range so the sweep doesn't scan the endpoint's whole delivery history (A-4).
  @@index([endpointId, createdAt])
}

model Connection {
  id        String   @id @default(uuid())
  tenantId  String
  // Env-scoped (design ENVIRONMENTS.md §3, Slice 5): a sandbox run binds to sandbox connections,
  // prod to prod — separate live/test integrations. Backfilled to the tenant's default env.
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  type      String // 'atlassian' | 'github' | 'custom'
  label     String
  serverUrl String // e.g. https://mcp.atlassian.com/v1/mcp
  authMode  String // 'api_token' | 'pat' | 'oauth'
  scopes    String[]
  status    String   @default("connected") // 'connected' | 'needs_reauth' | 'error'
  // secret/refresh token stored via the Slice #2 encrypted credential store, keyed by this id
  createdAt DateTime @default(now())

  @@unique([tenantId, environmentId, type, label])
}

model TenantBudget {
  id                 String  @id @default(uuid())
  tenantId           String  @unique
  monthlyCapUsd      Decimal @db.Decimal(12, 2)
  perExecutionCapUsd Decimal @db.Decimal(12, 2)
  maxStepsPerRun     Int     @default(50) // circuit breaker
  onBudgetExceeded   String  @default("reject") // 'reject' | 'downgrade' | 'pause' (Slice 3: park + resume via Signal)
  fallbackModel      String? // used when policy = 'downgrade'
  // Slice 3 (REDESIGN-FUNCTIONALITY-GAPS.md) — budget alert threshold. When set (1–100),
  // the reservation that first pushes month spend past monthlyCapUsd × pct/100 emits a
  // `budgetThreshold` notification. NULL = no alert configured.
  alertThresholdPct  Int?
  // Exactly-once-per-calendar-month marker for that alert ("YYYY-MM", UTC). Claimed
  // TRANSACTIONALLY with the crossing check inside reserveBudget (row-lock serializes
  // concurrent reservations), so at most one reservation per month owns the alert.
  lastAlertMonth     String?
}

model TenantCredential {
  id              String    @id @default(uuid())
  tenantId        String
  // Env-scoped (design ENVIRONMENTS.md §3, Slice 5): separate BYOK/provider keys per env — a sandbox
  // run uses test keys, prod live keys. Backfilled to the tenant's default env. NB the at-rest AAD
  // stays bound to `${tenantId}:${provider}` (NOT env) — env is a row-lookup concern, not a crypto
  // one, so backfilled rows still decrypt.
  environmentId   String
  environment     Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  provider        String // 'anthropic' | 'openai' | 'google' | 'ollama'
  ciphertext      String // base64 AES-256-GCM ciphertext
  iv              String // base64 nonce
  authTag         String // base64 GCM auth tag
  keyVersion      Int       @default(1) // at-rest format: 1 = legacy (no AAD), 2 = AAD-bound (Sec#7), 3 = per-tenant DEK (TenantKey envelope)
  isValid         Boolean   @default(false)
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())

  @@unique([tenantId, environmentId, provider])
}

// Per-tenant data-encryption key (DEK) for ENVELOPE encryption: a random 32-byte AES key,
// stored WRAPPED (AES-256-GCM, AAD `dek:<tenantId>`) by the master ENCRYPTION_KEY — the
// master is the key-encryption key (KEK) and never touches tenant data directly for
// keyVersion >= 3 rows. Minted lazily on a tenant's first secret write. Consequences:
//  - rotating the master = re-wrapping these small rows, not re-encrypting every secret;
//  - deleting a tenant's row crypto-shreds ALL their keyVersion 3 secrets (GDPR erasure);
//  - a leaked DEK exposes ONE tenant, never the fleet.
// The plaintext DEK exists in process memory only — never returned, logged, or traced.
model TenantKey {
  tenantId   String   @id
  ciphertext String // base64 AES-256-GCM ciphertext of the hex-encoded DEK
  iv         String // base64 nonce
  authTag    String // base64 GCM auth tag
  keyVersion Int      @default(2) // wrap format (master-key versioning hook)
  createdAt  DateTime @default(now())
}

model UsageEvent {
  id                String   @id @default(uuid())
  tenantId          String
  // Per-env cost VISIBILITY tag (design ENVIRONMENTS.md Slice 6). Nullable + no FK — billing stays
  // ONE bill per tenant: the budget aggregate/reservation/gate all sum across envs and never read
  // this column. It exists only so spend can later be BROKEN DOWN by env, never enforced by it.
  environmentId     String?
  executionId       String // Temporal workflowId
  nodeId            String
  provider          String
  model             String
  inputTokens       Int
  outputTokens      Int
  totalTokens       Int
  cachedInputTokens Int      @default(0)
  reasoningTokens   Int      @default(0)
  costUsd           Decimal  @db.Decimal(12, 6)
  // The node TYPE that spent this (Slice 2 — per-node timing + cost): "agent" | "codeAgent" |
  // "vectorUpsert" | … Stamped at the recording site (the activity statically knows which node
  // kind it serves), so by-node-type rollups need NO graph-snapshot join at query time — the
  // cheap honest option. Nullable: pre-feature rows have none and stay out of typed buckets.
  nodeType          String?
  // Wall-clock duration of the metered call, measured IN the activity around the provider
  // call (clock reads live in activities, never workflow code). Nullable for pre-feature rows.
  // Still tokens/cost/timing only — never prompt or completion text (ledger privacy).
  durationMs        Int?
  createdAt         DateTime @default(now())

  @@unique([executionId, nodeId]) // idempotent ledger: a retried activity can't double-write
  @@index([tenantId, createdAt])
  @@index([executionId])
}

// In-flight cost reservations (Arch§4.3). A run reserves its estimated cost
// BEFORE the LLM call and releases it after recording the actual UsageEvent, so
// concurrent runs for one tenant can't all overshoot the monthly cap. Dangling
// reservations (crash mid-call) stop counting after a short TTL.
model UsageReservation {
  id               String   @id @default(uuid())
  tenantId         String
  estimatedCostUsd Decimal  @db.Decimal(12, 6)
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Per-tenant ENVIRONMENT (design docs/design/ENVIRONMENTS.md) — sandbox / UAT / prod as fully
// separate spaces. Slice 1 is the entity + management only; env-SCOPING of workflows/runs/creds
// lands in later slices behind a `envId ?? default` compatibility shim. Exactly one `isDefault`
// per tenant (the "Production" env holding all pre-environments data); created lazily on first
// access (upsert on the unique slug — race-safe), so no backfill across implicit tenants is needed.
model Environment {
  id        String   @id @default(uuid())
  tenantId  String
  name      String // display: "Sandbox", "UAT", "Production"
  slug      String // stable, header/URL-safe: "sandbox", "uat", "prod"
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  graphDefinitions    GraphDefinition[]
  workflowActivations WorkflowActivation[]
  apiTokens           ApiToken[]
  webhookEndpoints    WebhookEndpoint[]
  formEndpoints       FormEndpoint[]
  chatEndpoints       ChatEndpoint[]
  connections         Connection[]
  tenantCredentials   TenantCredential[]
  variables           Variable[]
  templates            Template[]
  turnstileConfigs     TurnstileConfig[]
  notificationChannels NotificationChannel[]
  pinnedData           PinnedData[]
  errorHandlers        ErrorHandler[]
  workflowGrants       WorkflowGrant[]
  schedules            Schedule[]
  pollStates           PollState[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  // NB: a PARTIAL unique index `("tenantId") WHERE "isDefault"` (in the migration, not expressible
  // in Prisma's DSL) enforces exactly one default env per tenant at the DB level.
}

// NB: the legacy advisory `Member` directory (pre-U1 Team screen) was dropped in G3
// (20260801120000_drop_member_directory) — U1 seeded its rows into Invitation and made
// the Team screen Membership+Invitation-backed; Membership below is the authority.

// Multi-workspace membership (design: PROVISIONING-MULTIUSER.md). The AUTHORITY for
// which workspaces a user belongs to + their role — a user has one row per workspace.
// `userId` is the Firebase uid. Resolved per-request through MembershipCache; this
// table is the source of truth. (The guard does NOT enforce against this yet — added
// in a later slice; today it's populated + read by /me/workspaces only.)
model Membership {
  id           String    @id @default(uuid())
  userId       String // Firebase uid
  tenantId     String
  role         String    @default("member") // 'owner' | 'admin' | 'member'
  email        String? // the user's email at join time (directory convenience)
  createdAt    DateTime  @default(now())
  // Last time this user made an authenticated request in this workspace (the guard stamps
  // it, DB-side-throttled). NULL = never seen since the column was added. Telemetry only —
  // never an authz input.
  lastActiveAt DateTime?

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

// A pending workspace invitation (design: RBAC-GROUPS.md §3/§5, slice U1 — SUPERSEDES the
// PROVISIONING-MULTIUSER token-invite flow). Created by an owner/admin on the Team screen;
// converted to a Membership by the AuthGuard's accept-on-login when a user whose Firebase
// email is VERIFIED and matches `email` (case-insensitively; stored lowercased) signs in.
// `acceptedAt` null = pending. `groupIds` is honored from slice G1 on (permission groups
// joined on accept).
model Invitation {
  id         String    @id @default(uuid())
  tenantId   String
  email      String // matched against the VERIFIED Firebase email on login
  role       String    @default("member") // 'owner' | 'admin' | 'member'
  groupIds   Json? // permission-group ids joined on accept (used from G1 on)
  invitedBy  String // uid of the inviting owner/admin ('member-seed' for migrated rows)
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@unique([tenantId, email])
  @@index([email])
}

// ---- Permission groups + grants (RBAC-GROUPS.md §3, slice G1) ----
// Groups gate the `member` tier AND API tokens; owner/admin users and trigger-fired runs
// bypass. A workspace with ZERO WorkflowGrant rows behaves exactly as today; the FIRST
// grant flips members AND ungrouped tokens to deny-by-default (§4/§4a — the cliff).

model PermissionGroup {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  members      GroupMember[]
  tokenMembers GroupTokenMember[]
  grants       WorkflowGrant[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model GroupMember {
  groupId   String
  group     PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String // Firebase uid; must hold a Membership in the group's tenant
  createdAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

// API tokens as grant subjects (§4a). A SEPARATE join (not a polymorphic subject column on
// GroupMember): both FKs stay honest and Cascade — deleting a token or a group cleans its rows.
// Under §8.6 the workspace's first-grant cliff restricts tokens too; these rows are how a
// restricted token gets its access BACK (union of its groups' grants).
model GroupTokenMember {
  groupId   String
  group     PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tokenId   String
  token     ApiToken        @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([groupId, tokenId])
  @@index([tokenId])
}

// A group may hold several grants (e.g. view-all + edit-selected); effective = union.
model WorkflowGrant {
  id            String  @id @default(uuid())
  tenantId      String // denormalized: "does ANY grant exist in tenant?" is THE restriction switch
  groupId       String
  group         PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Env-scoped (§8.5 CONFIRMED — tenant-wide-only was rejected): null = every environment,
  // set = that environment only. Cascade FK: a grant naming a deleted env should vanish.
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  scope         String // 'all' | 'selected'
  canView       Boolean @default(false)
  canRun        Boolean @default(false)
  canEdit       Boolean @default(false)
  canDelete     Boolean @default(false)
  canShare      Boolean @default(false) // share = PROMOTE only (§8.2)
  // §8.3: creation is its OWN permission, never inferred from edit. Valid ONLY on scope='all'
  // grants (400 otherwise) — a 'selected'-scope creator would immediately lose sight of their
  // own new workflow, which is incoherent.
  canCreate     Boolean @default(false)
  workflows WorkflowGrantKey[] // only for scope='selected'
  tagGrants TagGrant[] // only for scope='selected' (RBAC-GROUPS.md §9 seam, shipped)

  @@index([tenantId])
  @@index([groupId])
}

model WorkflowGrantKey {
  grantId     String
  grant       WorkflowGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  workflowKey String

  @@id([grantId, workflowKey])
}

// Tag-scoped grants (RBAC-GROUPS.md §9 seam, SHIPPED): a 'selected'-scope grant may also name
// TAGS — its effective keys = its WorkflowGrantKey list ∪ the workflowKeys carrying ANY of its
// tags (union semantics, resolved at read time from WorkflowTag). Because tag MEMBERSHIP then
// carries access, editing a workflow's tags is SHARE-gated (promote) the moment a tenant has
// ≥1 TagGrant row — see TagsService.setWorkflowTags. Both FKs Cascade: deleting a grant or a
// tag cleans its rows (a deleted tag simply stops carrying access).
model TagGrant {
  grantId   String
  grant     WorkflowGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([grantId, tagId])
  @@index([tagId])
}

/// Non-secret per-workspace config, ENV-SCOPED, referenced in string expressions as
/// `{{ $vars.KEY }}`. The worker loads a workspace+env's variables into the run ctx under `$vars`
/// at start (as DATA), so a value can differ per environment (e.g. a URL in sandbox vs prod). NOT
/// for secrets — those resolve in-activity and never enter the graph/ctx/history (separate feature).
model Variable {
  tenantId      String
  environmentId String
  key           String
  value         String
  updatedAt     DateTime @default(now()) @updatedAt

  // Restrict (like the other env-scoped models) so an env can't be deleted out from under its
  // variables, leaving orphans — env deletion re-parents/clears rows first (see EnvironmentsService).
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  @@id([tenantId, environmentId, key])
  @@index([tenantId, environmentId])
}

// A reusable Form/Email template (docs/design/TEMPLATE-EDITOR.md). `blocks` is a TemplateBlock[]
// (JSON) authored in the block editor; the SAME array renders to an email (content blocks) or
// drives a form (field blocks). Env-scoped like Variable — a sandbox and a prod template are
// separate rows. NOT a secret (non-secret copy; `{{ $secrets.X }}` still resolves in-activity).
model Template {
  id            String   @id @default(cuid())
  tenantId      String
  environmentId String
  kind          String // "email" | "form"
  name          String
  subject       String? // email only (also templated with {{ }})
  blocks        Json // TemplateBlock[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  // Restrict (like Variable): an env can't be deleted out from under its templates.
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, environmentId, name])
  @@index([tenantId, environmentId])
}

// Cloudflare Turnstile bot-protection config for a tenant's public form/chat pages
// (docs/design/TURNSTILE-BOT-PROTECTION.md). Env-scoped like Variable. Holds only the PUBLIC site
// key + an enable toggle; the SECRET key lives encrypted in the SecretStore (TenantCredential,
// `turnstile:secret`), never here. `enabled` is a distinct toggle so a tenant can pause the gate
// without clearing keys (Slice 2 ingress enforces when enabled AND both keys present).
model TurnstileConfig {
  tenantId      String
  environmentId String
  siteKey       String
  enabled       Boolean  @default(true)
  updatedAt     DateTime @default(now()) @updatedAt

  // Restrict (like Variable): an env can't be deleted out from under its config.
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  @@id([tenantId, environmentId])
  @@index([tenantId, environmentId])
}

// Per-tenant settings (Settings screen). One row per tenant.
model TenantSettings {
  tenantId     String   @id
  displayName  String?
  defaultModel String? // e.g. 'claude-opus-4-8'
  // Nullable link to the org (Company) this workspace belongs to (COMPANIES.md). Additive:
  // standalone workspaces leave it null. onDelete: SetNull — deleting a company detaches, not
  // cascades. Company is NOT an isolation dimension; no tenantId-scoped query reads this.
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Soft + REVERSIBLE archive (COMPANIES.md Slice 4): set → hidden from the workspace
  // switcher; null → live. Runs/schedules/budgets are untouched — this is a UI-visibility
  // flag, not a lifecycle change.
  archivedAt   DateTime?
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([companyId])
}

/// An org grouping workspaces for cross-workspace admin + billing/usage rollup (COMPANIES.md).
/// NOT an isolation boundary — every tenantId-scoped query is unchanged; Company only adds a
/// cross-workspace authorization + read-model path on top.
model Company {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  createdAt   DateTime            @default(now())
  memberships CompanyMembership[]
  workspaces  TenantSettings[]
  budget      CompanyBudget?
  permissionGroups CompanyPermissionGroup[]
}

// ---- Company-wide permission groups (RBAC-GROUPS §9 / COMPANIES §9 composition) ----
// A SECOND grant source unioned into workspace permission resolution: company grants ADD
// access back for subjects a workspace has ALREADY restricted (its first-grant cliff).
// They NEVER flip a workspace's cliff — enforcement stays workspace-local (WorkflowGrant
// existence); an unenforced workspace is completely unaffected by company grants.

/// A named group of company members carrying (at most) one company-wide grant. Company-OWNER
/// managed. uid-keyed only — API tokens are workspace-scoped subjects and can never receive
/// company grants.
model CompanyPermissionGroup {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  members CompanyGroupMember[]
  grants  CompanyWorkflowGrant[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// uid-keyed membership; the user must hold a CompanyMembership in the group's company
/// (service-enforced, 400 otherwise). NO token analog on purpose — tokens live in one
/// workspace, and a cross-workspace secret would be the weakest link.
model CompanyGroupMember {
  groupId   String
  group     CompanyPermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String // Firebase uid
  createdAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

/// A company-wide grant: the six verbs, nothing else. DELIBERATELY no scope/keys/environmentId
/// columns in v1 — company grants are 'all'-scope + all-environments ONLY, because per-key and
/// per-env selections don't compose across workspaces (workflowKeys and environment ids are
/// workspace-local names; a key list picked in one workspace is meaningless in another). The
/// future seam: add nullable scope/env columns + a per-workspace key join and widen the
/// resolution mapping — nothing here blocks it. Resolution maps each row to an EffectiveGrant
/// {scope:'all', environmentId:null} unioned with the subject's workspace grants.
model CompanyWorkflowGrant {
  id        String   @id @default(uuid())
  groupId   String
  group     CompanyPermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  canView   Boolean  @default(false)
  canRun    Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  canShare  Boolean  @default(false) // share = PROMOTE only, same as workspace grants
  canCreate Boolean  @default(false) // coherent here: company grants are always 'all'-scope
  createdAt DateTime @default(now())

  @@index([groupId])
}

/// Company-wide monthly spend cap (COMPANIES.md §8, Slice 5): an OUTER start-time gate layered
/// ABOVE the per-workspace TenantBudgets — a run start must pass BOTH. Enforced fail-open
/// (Tier-1 rule 6): a metering/lookup error never blocks a run — the worker's per-tenant
/// reserveBudget remains the authoritative inner guard.
model CompanyBudget {
  companyId        String   @id
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  monthlyCapUsd    Decimal  @db.Decimal(12, 2)
  onBudgetExceeded String   @default("reject") // 'reject' (only mode today)
  updatedAt        DateTime @default(now()) @updatedAt
}

/// A user's role IN A COMPANY (distinct from the per-workspace Membership). Keyed by Firebase uid.
/// Grants the cross-workspace admin path; grants NO implicit per-workspace membership.
model CompanyMembership {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String // Firebase uid
  role      String   @default("admin") // 'owner' | 'admin'
  createdAt DateTime @default(now())

  @@id([companyId, userId])
  @@index([userId])
}

// One row per (tenant, channel type) — Slack, Teams, and (later) email each configured and
// toggled INDEPENDENTLY, so a run-failed alert can fan out to several at once rather than the
// old either/or single-row NotificationSettings (dropped after the #294 two-release dance —
// its rows were backfilled into this model). The worker reads all `enabled` rows and POSTs
// each, formatting per `type`. Event routing is per-channel (send failures to Slack, approvals
// to Teams, …). A tenant may have ANY NUMBER of channels per type (N Slack + N Teams
// webhooks — e.g. #alerts and #oncall); each row is addressed by its `id` and the worker
// fans out to every enabled row. `label` is the user-facing name distinguishing same-type rows.
model NotificationChannel {
  id                String   @id @default(uuid())
  tenantId          String
  environmentId     String // env-scoped (Slice 6b): a sandbox failure must not page prod's Slack
  type              String // "slack" | "teams" | "email"
  label             String? // user-facing name (e.g. "#alerts"); null = unnamed
  enabled           Boolean  @default(true)
  webhookUrl        String? // POST target for slack/teams; null for email channels
  // Channel-specific settings a URL can't hold. Email (Slice 4): { connectionId, to[] } —
  // the SMTP connection reference (same connection the sendEmail node uses; credentials
  // stay in the encrypted store, resolved only at send time) + recipient addresses.
  config            Json?
  onApprovalPending Boolean  @default(true)
  onRunFailed       Boolean  @default(true)
  // Slice 3: notify when monthly spend crosses the budget's alertThresholdPct. Default OFF —
  // an existing channel must opt in (the alert is new traffic, never surprise-enabled).
  onBudgetThreshold Boolean  @default(false)
  // Slice 4: notify when a workflow is promoted into this channel's environment. Default
  // OFF — promotions are new traffic, never surprise-enabled on an existing channel.
  onPromotion       Boolean  @default(false)
  createdAt         DateTime @default(now()) // stable list/fan-out order among same-type rows
  updatedAt         DateTime @default(now()) @updatedAt

  // Cascade (NOT Restrict): channels are disposable config — deleting an environment removes
  // its channels rather than 409-blocking the delete the way workflows/connections do.
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, environmentId])
}

// Per-USER preferences — personal + cross-workspace, so they follow a user across
// devices (unlike TenantSettings, which is per-workspace). Keyed by Firebase uid.
// Today: `mode` (Builder vs Simple experience, design PRODUCT-VARIANTS.md). Absent
// row = client default. API-token principals have no uid, so they stay client-only.
model UserPreference {
  userId    String   @id // Firebase uid
  mode      String? // 'builder' | 'simple' — the experience variant
  // Customizable Overview layout: an ordered array of { id, hidden, span } widget
  // entries. Null = never customized → the client uses the default layout.
  dashboard Json?
  updatedAt DateTime @default(now()) @updatedAt
}

// Append-only audit log: who did what, when (the activity feed). One row per
// successful mutating request, written by the AuditInterceptor. `actor` is the OIDC
// subject (or "api-token"); `action` is a human label derived from method+route.
model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  actor      String // OIDC subject, or "api-token"
  action     String // human label, e.g. "Saved a workflow"
  method     String // HTTP method
  path       String // request path (no query)
  statusCode Int
  // The actor's SELECTED environment context when they made the request (#464), resolved to a
  // canonical Environment.id (the guard's env selection is a slug from the SPA but a uuid from an
  // env-bound token — both normalize here). NULL when no env was selected. This is the actor's
  // context, NOT a resource FK — tenant-global mutations carry whatever env was active. No FK: a
  // historical record must not block env deletion.
  environmentId String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Queue-mode fleet registry (QUEUE-MODE.md §3.2): each worker replica upserts a heartbeat with its
// live slot usage. Infra telemetry only — NO tenant data, NO secrets (Tier-1 §4). The control plane
// reads it for the Worker view; staleness (lastSeen age) marks a replica offline. Keyed on the
// worker identity `<host>/<pid>/<version>`. The worker writes it directly (it already has DB access
// for the execution/usage ledgers) — no extra API surface.
model WorkerHeartbeat {
  identity         String   @id // <host>/<pid>/<version>
  taskQueue        String
  version          String
  host             String
  activeActivities Int      @default(0) // live: activities executing right now on this replica
  maxActivities    Int // configured slot capacity (WORKER_MAX_ACTIVITIES, else the SDK default)
  lastSeen         DateTime @default(now())

  @@index([lastSeen])
}

// Conversational AI builder (AI-BUILDER-CONVERSATION.md): a persisted, resumable session in which the
// user iteratively edits a workflow via chat. `currentGraph` is the authoritative working draft (each
// turn reads it as the model's `previous` and writes the new validated graph back). Closes on save or
// an explicit Done. Lives in the CONTROL PLANE (workers stay stateless). Slice 1 = lifecycle only
// (turns are appended by the Slice-2 edit endpoint). PRIVACY: conversation stores user prompts —
// tenant-scoped, never sent to telemetry.
model BuilderSession {
  id            String        @id @default(uuid())
  tenantId      String
  environmentId String? // the env the build targets
  workflowKey   String? // seeded-from / saved-to workflow, when applicable
  status        String        @default("open") // open | closed
  closedReason  String? // saved | done | abandoned
  currentGraph  Json? // the working draft (latest validated graph)
  title         String? // short label for the resume list (first prompt, trimmed)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  closedAt      DateTime?
  turns         BuilderTurn[]

  @@index([tenantId, status, updatedAt])
}

// Tenant-wide ($secrets) secrets (#459): a named secret that applies to EVERY environment, unlike
// TenantCredential-backed env secrets. Same `secret:<NAME>` key namespace + same per-tenant envelope
// encryption (AAD `${tenantId}:${key}`, env-independent — so ciphertext is crypto-identical to an env
// secret). A SEPARATE table (not a null-env TenantCredential row) because TenantCredential's env FK is
// NOT NULL and its unique is (tenantId, environmentId, provider) — a null env would break both. At
// read time an env-specific secret of the same NAME OVERRIDES the tenant-wide one (env wins).
model TenantSecret {
  id         String   @id @default(uuid())
  tenantId   String
  key        String // same namespace as env secrets, e.g. `secret:MY_KEY`
  ciphertext String // base64 AES-256-GCM ciphertext
  iv         String // base64 nonce
  authTag    String // base64 GCM auth tag
  keyVersion Int      @default(3) // at-rest format: 3 = per-tenant DEK (TenantKey envelope)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, key])
}

model BuilderTurn {
  id        String   @id @default(uuid())
  sessionId String
  role      String // user | assistant
  content   String // user prompt, or a short assistant summary of the change
  costUsd   Decimal? @db.Decimal(12, 6) // metered per assistant turn (BYOK)
  options   String[] @default([]) // assistant-turn tappable quick-reply suggestions (#487); empty on user turns
  createdAt DateTime @default(now())

  session BuilderSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
