    "url": "git+https://github.com/IFF-Productions/naary-orchestrator.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "naary",
    "workflow",
    "automation",
    "cli",
    "temporal"
  ],
  "main": "dist/index.js",
