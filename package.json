{
  "name": "naary-orchestrator",
  "version": "0.0.31",
  "private": true,
  "description": "Durable, platform-agnostic orchestrator for AI-agent + webhook workflows (Temporal interpreter spine).",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:generate": "pnpm --filter @naary/db run generate",
    "db:migrate": "pnpm --filter @naary/db run migrate",
    "db:studio": "pnpm --filter @naary/db run studio",
    "build": "pnpm db:generate && tsc -b",
    "typecheck": "pnpm db:generate && tsc -b && pnpm -r run typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:live": "pnpm build && vitest run --config vitest.live.config.ts",
    "worker": "pnpm --filter @naary/worker start",
    "gen:api": "pnpm --filter @naary/api gen:openapi && pnpm --filter @naary/web gen:api-types",
    "check:api-types": "pnpm gen:api && git diff --exit-code -- apps/api/openapi.json",
    "gen:integration-docs": "npx tsc -b packages/dsl && node packages/dsl/scripts/gen-integration-docs.mjs",
    "check:integration-docs": "pnpm gen:integration-docs && git diff --exit-code -- docs/integrations",
    "start": "pnpm --filter @naary/api start",
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "dev:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "dev:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f api worker",
    "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "dev:web": "pnpm --filter @naary/web dev",
    "prod": "docker compose --env-file ./deploy/.env -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d --build"
  },
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@swc/register": "^0.1.10",
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^29.1.1",
    "prisma": "7.9.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
