{
  "name": "naary-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Durable, platform-agnostic orchestrator for AI-agent + webhook workflows (Temporal interpreter spine).",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:generate": "pnpm --filter @naary/db run generate",
    "db:migrate": "pnpm --filter @naary/db run migrate",
    "db:studio": "pnpm --filter @naary/db run studio",
    "build": "pnpm db:generate && tsc -b",
    "typecheck": "pnpm db:generate && tsc -b && pnpm -r run typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "worker": "pnpm --filter @naary/worker start",
    "start": "pnpm --filter @naary/api start",
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "dev:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "dev:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f api worker",
    "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@types/node": "^26.0.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.9"
  }
}
