# Copy to .env (gitignored) and fill in real values. Do NOT commit real values.

# Postgres credentials — consumed by docker-compose.yml (POSTGRES_*) and Prisma
# (DATABASE_URL). Keep the password here and inside DATABASE_URL in sync.
POSTGRES_USER="naary"
POSTGRES_PASSWORD="choose-a-local-password"
POSTGRES_DB="naary_orchestrator"

# Prisma connection string — same host/creds as the Postgres vars above.
DATABASE_URL="postgresql://naary:choose-a-local-password@localhost:5432/naary_orchestrator?schema=public"

# 32-byte hex master key for tenant-credential encryption (Slice #2 Task 1).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="d411941f3d668658dc3942847a957162508d13458c6e2bd6407b13f405899996"

# --- Public URLs -----------------------------------------------------------
# CORS_ORIGINS: comma-separated allowlist of browser origins the API accepts
# (the SPA's public URL). REQUIRED in prod for the app to reach the API.
# CORS_ORIGINS="https://app.yourdomain.com"
#
# APP_BASE_URL: the SPA's public URL, used by the WORKER to build absolute deep
# links in Slack/Teams alerts — a clickable run link + one-click Approve/Reject
# buttons. If UNSET, the worker falls back to the first absolute http(s) origin
# in CORS_ORIGINS; if neither is set, alerts still send but with a bare run id
# and no buttons (the worker logs a warning at boot).
# APP_BASE_URL="https://app.yourdomain.com"

# Object storage for the >2MB claim-check (Arch§4.6). Default (unset) = in-memory
# (dev/tests). For AWS: STORAGE_PROVIDER=s3 + a bucket + region (creds via the
# standard AWS chain). The ObjectStore interface is the GCP swap point (add gcs later).
# STORAGE_PROVIDER="s3"
# S3_BUCKET="naary-payloads"
# AWS_REGION="us-east-1"

# --- Firebase Auth (human login) -------------------------------------------
# Firebase replaced Keycloak. Two halves:
#
# 1) API (verifies ID tokens) — REQUIRES a service account. Paste the service
#    account JSON as a single line, or mount the key file and set
#    GOOGLE_APPLICATION_CREDENTIALS instead. UNSET ⇒ Firebase auth is OFF
#    (the `nry_` API-token path still works).
FIREBASE_PROJECT_ID="naary-7b78f"
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"naary-7b78f",...}'
FIREBASE_TENANT_CLAIM="tenant"
#
# 2) SPA (login UI) — the PUBLIC Firebase web config, inlined into the bundle at
#    build time (docker-compose passes these as web build args). Firebase web keys
#    are not secrets. From the Firebase console → Project settings → Web app.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="naary-7b78f.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="naary-7b78f"
VITE_FIREBASE_STORAGE_BUCKET="naary-7b78f.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="612653475146"
VITE_FIREBASE_APP_ID=""
#
# Assign a tenant to a user (the `tenant` custom claim the API authorizes on):
#   pnpm --filter @naary/api exec ts-node src/auth/set-tenant-claim.ts <uid> <tenantId>

# --- Observability (Sentry) ------------------------------------------------
# Error monitoring for the API + worker. Leave SENTRY_DSN UNSET to keep it OFF
# (no events sent). Events are scrubbed of secrets before send (@naary/observability).
# SENTRY_TRACES_SAMPLE_RATE turns on performance tracing (0 = off).
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"

# --- Structured logging ----------------------------------------------------
# api + worker emit JSON logs (one line per event, secrets scrubbed) carrying
# correlation/tenant/execution IDs. LOG_LEVEL sets verbosity:
# trace|debug|info|warn|error|fatal (default info).
LOG_LEVEL="info"

# --- Metrics ---------------------------------------------------------------
# Prometheus /metrics. The api exposes it on its main port (3000); the worker
# (no HTTP server of its own) serves it on METRICS_PORT. Set 0 to disable.
METRICS_PORT="9091"

# --- Feature flags (OpenFeature + Flagsmith) -------------------------------
# Server-side flag evaluation for the API (GET /me/flags). Leave the KEY UNSET to
# keep flags OFF — every flag resolves to its safe code default (packages/flags,
# fail-safe, exactly like Sentry above). FLAGSMITH_ENVIRONMENT_KEY is the
# SERVER-SIDE key (starts with `ser.`), never shipped to the browser. For a
# self-hosted instance, run the docker-compose.flagsmith.yml overlay and point
# FLAGSMITH_API_URL at the in-stack service; omit it for Flagsmith SaaS.
FLAGSMITH_ENVIRONMENT_KEY=""
# FLAGSMITH_API_URL="http://flagsmith:8000/api/v1/"   # self-hosted overlay only

# --- Temporal connection ---------------------------------------------------
# Defaults to the local dev server (localhost:7233, namespace "default", no TLS).
# Leave these UNSET for local/docker. For Temporal Cloud, set TEMPORAL_NAMESPACE
# to the fully-qualified "<ns>.<acct>" and pick ONE auth method below.
#
# API key (recommended) — connects to a SHARED REGIONAL endpoint; TLS is
# auto-enabled and the namespace is sent as routing metadata for you:
#   TEMPORAL_ADDRESS="<region>.<cloud>.api.temporal.io:7233"   # e.g. us-east-1.aws.api.temporal.io:7233
#   TEMPORAL_NAMESPACE="<ns>.<acct>"
#   TEMPORAL_API_KEY="<key>"
#
# mTLS — connects to the NAMESPACE-specific endpoint (namespace is in the host):
#   TEMPORAL_ADDRESS="<ns>.<acct>.tmprl.cloud:7233"
#   TEMPORAL_NAMESPACE="<ns>.<acct>"
#   TEMPORAL_TLS_CERT_PATH="/path/client.pem"   # both required
#   TEMPORAL_TLS_KEY_PATH="/path/client.key"
#   TEMPORAL_TLS_SERVER_NAME=""                 # optional SNI override
#
# TEMPORAL_TLS="true" forces plain TLS with no client cert (e.g. a TLS proxy).
