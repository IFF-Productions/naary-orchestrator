# Copy to .env (gitignored) and fill in real values. Do NOT commit real values.

# Postgres credentials — consumed by docker-compose.yml (POSTGRES_*) and Prisma
# (DATABASE_URL). Keep the password here and inside DATABASE_URL in sync.
POSTGRES_USER="naary"
POSTGRES_PASSWORD="choose-a-local-password"
POSTGRES_DB="naary_orchestrator"

# Prisma connection string — same host/creds as the Postgres vars above.
DATABASE_URL="postgresql://naary:choose-a-local-password@localhost:5432/naary_orchestrator?schema=public"

# 32-byte hex master key for tenant-credential encryption (Slice #2 Task 1).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""
