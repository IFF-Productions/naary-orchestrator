{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  // Storybook stories are a DEV concern — they import dev-only workspace packages
  // (@naary/notifications) + Storybook/MSW devDeps. Keep them out of the production build
  // (the web Docker image only prebuilds @naary/dsl, so a story's tsc would fail there).
  // Stories are typechecked separately via tsconfig.storybook.json (`typecheck:stories`).
  "exclude": ["src/**/*.stories.tsx"]
}
