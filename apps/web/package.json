{
  "name": "@naary/web",
  "version": "0.0.15",
  "private": true,
  "description": "Naary web app — durable AI-agent workflow orchestrator UI (Vite + React + TS).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.storybook.json",
    "typecheck:stories": "tsc --noEmit -p tsconfig.storybook.json",
    "test:e2e": "playwright test",
    "gen:api-types": "openapi-typescript ../api/openapi.json -o src/lib/api/schema.d.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@naary/dsl": "workspace:*",
    "@naary/notifications": "workspace:*",
    "@sentry/react": "^10.66.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.2",
    "codemirror": "^6.0.2",
    "firebase": "^12.16.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/react-vite": "^10.5.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "openapi-typescript": "6.7.6",
    "storybook": "^10.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
