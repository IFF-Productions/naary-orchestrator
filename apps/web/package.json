{
  "name": "@naary/web",
  "version": "0.0.77",
  "private": true,
  "description": "Naary web app — durable AI-agent workflow orchestrator UI (Vite + React + TS).",
  "type": "module",
  "scripts": {
    "dev": "pnpm run gen:api-types && vite",
    "build": "pnpm run gen:api-types && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm run gen:api-types && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.storybook.json",
    "typecheck:stories": "tsc --noEmit -p tsconfig.storybook.json",
    "test:e2e": "playwright test",
    "gen:api-types": "openapi-typescript ../api/openapi.json -o src/lib/api/schema.d.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit:responsive": "storybook build -o storybook-static --quiet && node scripts/responsive-audit.mjs --sb storybook-static"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@naary/dsl": "workspace:*",
    "@naary/notifications": "workspace:*",
    "@sentry/react": "^10.69.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "firebase": "^12.17.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "openapi-typescript": "6.7.6",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "msw": {
    "_comment": "NOT \"public\" (#1049) — Vite copies public/ into the SHIPPED dist/. Storybook is the only consumer; see .storybook/main.ts. msw init/postinstall write the worker to the dirs listed here.",
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
